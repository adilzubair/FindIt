ontSize="11" Margin="0,9,0,0"><Button.ContextMenu><ContextMenu Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource InkBrush}"><MenuItem Header="Check for updates" Click="CheckUpdatesClick"/><MenuItem Header="Install offline update…" Click="InstallUpdateClick"/></ContextMenu></Button.ContextMenu></Button><Button Click="EjectClick" Content="Close and eject…" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,12,0,0"/></StackPanel></Grid></Border>
