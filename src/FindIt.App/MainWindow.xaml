<Window
  x:Class="FindIt.App.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:FindIt.App"
  Title="FindIt"
  FontFamily="{StaticResource AppFont}"
  FontSize="13"
  Foreground="{DynamicResource InkBrush}"
  Width="1400"
  Height="900"
  MinWidth="880"
  MinHeight="520"
  WindowStartupLocation="CenterScreen"
  PreviewKeyDown="WindowKeyDown"
  Closing="WindowClosing"
  SizeChanged="WindowSizeChanged"
  UseLayoutRounding="True"
  SnapsToDevicePixels="True">
  <Window.Resources>
    <BooleanToVisibilityConverter
      x:Key="BoolVisibility" />
    <local:TextPresenceConverter
      x:Key="TextPresence" />
    <Style
      x:Key="RowContainer"
      TargetType="ListBoxItem">
      <Setter
        Property="Padding"
        Value="0" />
      <Setter
        Property="Margin"
        Value="0,0,0,12" />
      <Setter
        Property="Focusable"
        Value="False" />
      <Setter
        Property="HorizontalContentAlignment"
        Value="Stretch" />
      <Setter
        Property="Template">
        <Setter.Value>
          <ControlTemplate
            TargetType="ListBoxItem">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate
      x:Key="TileTemplate">
      <Button
        Style="{StaticResource ResultButton}"
        Loaded="TileLoaded"
        Unloaded="TileUnloaded"
        Click="ResultClick"
        Tag="{Binding}"
        Width="{Binding TileWidth}"
        Margin="0,0,12,0"
        ToolTip="{Binding Result.RelativePath}"
        AutomationProperties.Name="{Binding AccessibleName}">
        <StackPanel>
          <Border
            CornerRadius="8"
            Background="{DynamicResource PreviewBrush}"
            Height="{Binding ThumbnailHeight}"
            ClipToBounds="True">
            <Grid>
              <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding GlyphVisibility}">
                <TextBlock
                  Text="{Binding KindGlyph}"
                  FontFamily="Segoe MDL2 Assets"
                  FontSize="30"
                  Foreground="{DynamicResource MutedBrush}"
                  HorizontalAlignment="Center" />
                <TextBlock
                  Text="{Binding KindLabel}"
                  FontSize="12"
                  Foreground="{DynamicResource MutedBrush}"
                  Margin="0,8,0,0"
                  HorizontalAlignment="Center" />
              </StackPanel>
              <TextBlock
                Text="{Binding Result.Snippet}"
                Visibility="{Binding HasTextPreview, Converter={StaticResource BoolVisibility}}"
                TextWrapping="Wrap"
                FontSize="12"
                LineHeight="19"
                Margin="16,12,16,28"
                TextTrimming="CharacterEllipsis"
                Foreground="{DynamicResource MutedBrush}" />
              <Image
                Source="{Binding Thumbnail}"
                Stretch="Uniform" />
              <Border
                Background="{DynamicResource SurfaceBrush}"
                CornerRadius="4"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="8"
                Padding="6,2">
                <TextBlock
                  Text="{Binding KindLabel}"
                  FontSize="10" />
              </Border>
            </Grid>
          </Border>
          <Grid
            Height="48"
            Margin="2,0">
            <Grid.RowDefinitions>
              <RowDefinition
                Height="25" />
              <RowDefinition
                Height="23" />
            </Grid.RowDefinitions>
            <TextBlock
              Text="{Binding Result.Name}"
              TextTrimming="CharacterEllipsis"
              VerticalAlignment="Bottom"
              FontSize="13" />
            <TextBlock
              Grid.Row="1"
              Text="{Binding Subtitle}"
              TextTrimming="CharacterEllipsis"
              Foreground="{DynamicResource MutedBrush}"
              FontSize="12"
              VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Button>
    </DataTemplate>
    <DataTemplate
      x:Key="PersonTileTemplate">
      <Button
        Style="{StaticResource ResultButton}"
        Width="{Binding TileWidth}"
        Margin="0,0,12,0"
        Tag="{Binding}"
        Click="PersonTileClick"
        Loaded="PersonTileLoaded"
        Unloaded="PersonTileUnloaded"
        AutomationProperties.Name="{Binding AccessibleName}">
        <StackPanel>
          <Border
            Height="132"
            CornerRadius="8"
            Background="{DynamicResource PreviewBrush}">
            <Grid>
              <TextBlock
                Text="{Binding Initials}"
                FontSize="32"
                Foreground="{DynamicResource MutedBrush}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center" />
              <Image
                Source="{Binding Portrait}"
                Stretch="Uniform" />
            </Grid>
          </Border>
          <TextBlock
            Text="{Binding Person.Name}"
            TextTrimming="CharacterEllipsis"
            FontWeight="SemiBold"
            Margin="2,8,2,0" />
          <TextBlock
            Text="{Binding Person.ObservationCount, StringFormat={}{0:N0} observations}"
            Foreground="{DynamicResource MutedBrush}"
            FontSize="12"
            Margin="2,4,2,4" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>
  <Grid
    Background="{DynamicResource CanvasBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition
        Width="216" />
      <ColumnDefinition
        Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition
        Height="*" />
      <RowDefinition
        Height="28" />
    </Grid.RowDefinitions>
    <Border
      Background="{DynamicResource SidebarBrush}"
      BorderBrush="{DynamicResource BorderBrush}"
      BorderThickness="0,0,1,0">
      <Grid
        Margin="16,24,16,16">
        <Grid.RowDefinitions>
          <RowDefinition
            Height="Auto" />
          <RowDefinition
            Height="*" />
          <RowDefinition
            Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <StackPanel
            Orientation="Horizontal"
            Margin="12,0,0,32">
            <Border
              Background="{DynamicResource AccentButtonBrush}"
              Width="28"
              Height="28"
              CornerRadius="7">
              <Path
                Data="M 0,0 L 14,0 14,4 4,4 4,8 11,8 11,12 4,12 4,18 0,18 Z"
                Fill="{DynamicResource AccentButtonForegroundBrush}"
                Stretch="Uniform"
                Width="13"
                Height="17" />
            </Border>
            <TextBlock
              Text="FindIt"
              FontSize="21"
              FontWeight="SemiBold"
              Margin="10,0,0,0"
              VerticalAlignment="Center" />
          </StackPanel>
          <Button
            x:Name="SearchNav"
            Style="{StaticResource NavButton}"
            Click="SearchNavClick"
            AutomationProperties.Name="Library">
            <StackPanel
              Orientation="Horizontal">
              <TextBlock
                Text=""
                FontFamily="Segoe MDL2 Assets"
                Margin="0,0,12,0" />
              <TextBlock
                Text="Library" />
            </StackPanel>
          </Button>
          <Button
            x:Name="PeopleNav"
            Style="{StaticResource NavButton}"
            Click="PeopleNavClick"
            AutomationProperties.Name="People">
            <StackPanel
              Orientation="Horizontal">
              <TextBlock
                Text=""
                FontFamily="Segoe MDL2 Assets"
                Margin="0,0,12,0" />
              <TextBlock
                Text="People" />
            </StackPanel>
          </Button>
          <Button
            x:Name="FoldersNav"
            Style="{StaticResource NavButton}"
            Click="FoldersNavClick"
            AutomationProperties.Name="Folders">
            <StackPanel
              Orientation="Horizontal">
              <TextBlock
                Text=""
                FontFamily="Segoe MDL2 Assets"
                Margin="0,0,12,0" />
              <TextBlock
                Text="Folders" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel
          Grid.Row="2">
          <Border
            x:Name="PortableHint"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,18,8,16">
            <StackPanel>
              <StackPanel
                Orientation="Horizontal">
                <TextBlock
                  Text=""
                  FontFamily="Segoe MDL2 Assets"
                  Margin="0,0,8,0"
                  Foreground="{DynamicResource MutedBrush}" />
                <TextBlock
                  x:Name="DriveName"
                  Text="Your archive"
                  FontWeight="SemiBold"
                  TextTrimming="CharacterEllipsis"
                  MaxWidth="140" />
              </StackPanel>
              <TextBlock
                x:Name="DriveLocation"
                Foreground="{DynamicResource MutedBrush}"
                TextTrimming="CharacterEllipsis"
                FontSize="12"
                Margin="0,6,0,0"
                ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
              <StackPanel
                Orientation="Horizontal"
                Margin="0,10,0,0">
                <Ellipse
                  x:Name="ConnectionDot"
                  Fill="{DynamicResource ReadyBrush}"
                  Width="6"
                  Height="6"
                  Margin="0,0,7,0" />
                <TextBlock
                  x:Name="ConnectionLabel"
                  Text="Opening archive"
                  Foreground="{DynamicResource MutedBrush}"
                  FontSize="12" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Button
            x:Name="PrepareNav"
            Style="{StaticResource NavButton}"
            Click="PrepareNavClick"
            AutomationProperties.Name="Prepare drive">
            <StackPanel
              Orientation="Horizontal">
              <TextBlock
                Text=""
                FontFamily="Segoe MDL2 Assets"
                Margin="0,0,12,0" />
              <TextBlock
                Text="Prepare drive" />
            </StackPanel>
          </Button>
          <Button
            x:Name="ThemeButton"
            Style="{StaticResource NavButton}"
            Click="ThemeClick"
            AutomationProperties.Name="Appearance">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem
                  Header="Follow Windows"
                  Tag="System"
                  IsCheckable="True"
                  Click="ThemeMenuClick" />
                <MenuItem
                  Header="Light"
                  Tag="Light"
                  IsCheckable="True"
                  Click="ThemeMenuClick" />
                <MenuItem
                  Header="Dark"
                  Tag="Dark"
                  IsCheckable="True"
                  Click="ThemeMenuClick" />
              </ContextMenu>
            </Button.ContextMenu>
            <StackPanel
              Orientation="Horizontal">
              <TextBlock
                Text=""
                FontFamily="Segoe MDL2 Assets"
                Margin="0,0,12,0" />
              <TextBlock
                Text="Appearance" />
            </StackPanel>
          </Button>
          <Button
            x:Name="UpdatesButton"
            Style="{StaticResource NavButton}"
            Click="UpdatesClick"
            AutomationProperties.Name="App updates">
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem
                  Header="Check for updates"
                  Click="CheckUpdatesClick" />
                <MenuItem
                  Header="Install offline update…"
                  Click="InstallUpdateClick" />
              </ContextMenu>
            </Button.ContextMenu>
            <StackPanel
              Orientation="Horizontal">
              <TextBlock
                Text=""
                FontFamily="Segoe MDL2 Assets"
                Margin="0,0,12,0" />
              <TextBlock
                Text="App updates" />
            </StackPanel>
          </Button>
          <Button
            Style="{StaticResource NavButton}"
            Click="EjectClick">
            <StackPanel
              Orientation="Horizontal">
              <TextBlock
                Text=""
                FontFamily="Segoe MDL2 Assets"
                Margin="0,0,12,0" />
              <TextBlock
                Text="Close and eject" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid
      Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition
          Height="72" />
        <RowDefinition
          Height="Auto" />
        <RowDefinition
          Height="*" />
      </Grid.RowDefinitions>
      <Border
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,0,0,1">
        <Grid
          x:Name="QueryToolsPanel"
          Margin="28,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition
              Width="*" />
            <ColumnDefinition
              Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid>
            <TextBox
              x:Name="QueryBox"
              KeyDown="QueryKeyDown"
              Padding="36,8,12,8"
              AutomationProperties.Name="Search this drive"
              ToolTip="Describe a photo, video moment, or file. Press Enter to search." />
            <TextBlock
              Text=""
              FontFamily="Segoe MDL2 Assets"
              Margin="12,0,0,0"
              Foreground="{DynamicResource MutedBrush}"
              VerticalAlignment="Center"
              IsHitTestVisible="False"
              HorizontalAlignment="Left" />
            <TextBlock
              Text="Search your files, or describe what you remember"
              Margin="36,0,12,0"
              Foreground="{DynamicResource MutedBrush}"
              IsHitTestVisible="False"
              VerticalAlignment="Center">
              <TextBlock.Style>
                <Style
                  TargetType="TextBlock">
                  <Setter
                    Property="Visibility"
                    Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger
                      Binding="{Binding Text, ElementName=QueryBox}"
                      Value="">
                      <Setter
                        Property="Visibility"
                        Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <Button
            Grid.Column="1"
            Click="SearchClick"
            Style="{StaticResource PrimaryButton}"
            Content="Search"
            Padding="20,8"
            Margin="12,0,0,0" />
          <ProgressBar
            x:Name="SearchProgress"
            Grid.ColumnSpan="2"
            Height="2"
            IsIndeterminate="True"
            VerticalAlignment="Bottom"
            Margin="0,0,0,-16"
            Visibility="Collapsed"
            Foreground="{DynamicResource AccentBrush}"
            AutomationProperties.Name="Searching" />
        </Grid>
      </Border>
      <Border
        Grid.Row="1"
        x:Name="NoticeBar"
        Visibility="Collapsed"
        Background="{DynamicResource TintBrush}"
        CornerRadius="6"
        Padding="12"
        Margin="28,16,28,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition
              Width="*" />
            <ColumnDefinition
              Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock
            x:Name="NoticeText"
            TextWrapping="Wrap"
            FontSize="12"
            VerticalAlignment="Center" />
          <Button
            Grid.Column="1"
            Content=""
            FontFamily="Segoe MDL2 Assets"
            Style="{StaticResource IconButton}"
            Click="DismissNoticeClick"
            AutomationProperties.Name="Dismiss notification"
            ToolTip="Dismiss notification"
            Margin="12,0,0,0" />
        </Grid>
      </Border>
      <Grid
        Grid.Row="2"
        Margin="28,24,28,16">
        <Grid
          x:Name="SearchPage">
          <Grid.RowDefinitions>
            <RowDefinition
              Height="Auto" />
            <RowDefinition
              Height="Auto" />
            <RowDefinition
              Height="Auto" />
            <RowDefinition
              Height="*" />
            <RowDefinition
              Height="Auto" />
          </Grid.RowDefinitions>
          <Grid
            x:Name="SearchHeadingRow"
            Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition
                Width="*" />
              <ColumnDefinition
                Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Name="SearchTitle"
              Text="Library"
              Style="{StaticResource HeadingText}" />
            <StackPanel
              Grid.Column="1"
              Orientation="Horizontal">
              <ComboBox
                x:Name="DensitySelector"
                SelectedIndex="1"
                SelectionChanged="DensityChanged"
                Width="112"
                AutomationProperties.Name="Gallery size"
                Margin="0,0,12,0">
                <ComboBoxItem
                  Content="Compact" />
                <ComboBoxItem
                  Content="Comfortable" />
                <ComboBoxItem
                  Content="Large" />
              </ComboBox>
              <Button
                x:Name="GridViewButton"
                Click="GridViewClick"
                Style="{StaticResource IconButton}"
                ToolTip="Gallery view"
                AutomationProperties.Name="Gallery view"
                Content=""
                FontFamily="Segoe MDL2 Assets"
                Margin="0,0,4,0" />
              <Button
                x:Name="ListViewButton"
                Click="ListViewClick"
                Style="{StaticResource IconButton}"
                ToolTip="List view"
                AutomationProperties.Name="List view"
                Content=""
                FontFamily="Segoe MDL2 Assets" />
            </StackPanel>
          </Grid>
          <Grid
            Grid.Row="1"
            Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition
                Width="*" />
              <ColumnDefinition
                Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
              Orientation="Horizontal">
              <ToggleButton
                x:Name="AllTab"
                Tag="0"
                Content="All"
                IsChecked="True"
                Click="TypeTabClick"
                Style="{StaticResource TypeTab}" />
              <ToggleButton
                x:Name="PhotosTab"
                Tag="1"
                Content="Photos"
                Click="TypeTabClick"
                Style="{StaticResource TypeTab}" />
              <ToggleButton
                x:Name="VideosTab"
                Tag="2"
                Content="Videos"
                Click="TypeTabClick"
                Style="{StaticResource TypeTab}" />
              <ToggleButton
                x:Name="DocumentsTab"
                Tag="3"
                Content="Documents"
                Click="TypeTabClick"
                Style="{StaticResource TypeTab}" />
              <ToggleButton
                x:Name="AudioTab"
                Tag="4"
                Content="Audio"
                Click="TypeTabClick"
                Style="{StaticResource TypeTab}" />
            </StackPanel>
            <Button
              Grid.Column="1"
              x:Name="FiltersButton"
              Click="FiltersClick"
              Padding="12,8">
              <StackPanel
                Orientation="Horizontal">
                <TextBlock
                  Text=""
                  FontFamily="Segoe MDL2 Assets"
                  Margin="0,0,8,0" />
                <TextBlock
                  Text="Filters" />
              </StackPanel>
            </Button>
            <ComboBox
              x:Name="KindFilter"
              Visibility="Collapsed"
              SelectionChanged="FilterChanged">
              <ComboBoxItem
                Content="All" />
              <ComboBoxItem
                Content="Photos" />
              <ComboBoxItem
                Content="Videos" />
              <ComboBoxItem
                Content="Documents" />
              <ComboBoxItem
                Content="Audio" />
            </ComboBox>
            <Popup
              x:Name="FiltersPopup"
              PlacementTarget="{Binding ElementName=FiltersButton}"
              Placement="Bottom"
              StaysOpen="False"
              AllowsTransparency="True"
              PopupAnimation="None">
              <Border
                Style="{StaticResource PanelBorder}"
                BorderThickness="1"
                Padding="20"
                Width="328"
                Margin="4,8,4,4">
                <ScrollViewer
                  VerticalScrollBarVisibility="Auto"
                  MaxHeight="380">
                  <StackPanel>
                    <TextBlock
                      Text="Filter your library"
                      FontWeight="SemiBold"
                      FontSize="14"
                      Margin="0,0,0,16" />
                    <TextBlock
                      Text="Date"
                      Margin="0,0,0,6" />
                    <ComboBox
                      x:Name="DateFilter"
                      SelectionChanged="FilterChanged"
                      AutomationProperties.Name="Date">
                      <ComboBoxItem
                        Content="Any date" />
                      <ComboBoxItem
                        Content="Last 30 days" />
                      <ComboBoxItem
                        Content="This year" />
                      <ComboBoxItem
                        Content="Date range…" />
                    </ComboBox>
                    <StackPanel
                      x:Name="DateRangePanel"
                      Visibility="Collapsed"
                      Margin="0,8,0,0">
                      <DatePicker
                        x:Name="AfterDate"
                        SelectedDateChanged="DateRangeChanged"
                        AutomationProperties.Name="From date"
                        ToolTip="From date, inclusive" />
                      <TextBlock
                        Text="to"
                        Margin="0,4" />
                      <DatePicker
                        x:Name="BeforeDate"
                        SelectedDateChanged="DateRangeChanged"
                        AutomationProperties.Name="To date"
                        ToolTip="To date, inclusive" />
                    </StackPanel>
                    <TextBlock
                      Text="Folder"
                      Margin="0,16,0,6" />
                    <ComboBox
                      x:Name="FolderFilter"
                      DisplayMemberPath="Label"
                      SelectionChanged="FilterChanged"
                      AutomationProperties.Name="Folder filter" />
                    <TextBlock
                      Text="Person"
                      Margin="0,16,0,6" />
                    <ComboBox
                      x:Name="PersonFilter"
                      DisplayMemberPath="Name"
                      SelectionChanged="FilterChanged"
                      AutomationProperties.Name="Person filter" />
                    <CheckBox
                      x:Name="ExactFilter"
                      Content="Match exact words"
                      Checked="ExactChanged"
                      Unchecked="ExactChanged"
                      Margin="0,16,0,0" />
                    <Button
                      Content="Clear filters"
                      Click="ClearFiltersClick"
                      Style="{StaticResource QuietButton}"
                      HorizontalAlignment="Left"
                      Margin="0,12,0,0" />
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <WrapPanel
            Grid.Row="2"
            x:Name="ActiveFilterPanel"
            Visibility="Collapsed"
            Margin="0,0,0,12" />
          <Grid
            Grid.Row="3"
            x:Name="ResultsArea"
            SizeChanged="ResultsSizeChanged">
            <Grid.ColumnDefinitions>
              <ColumnDefinition
                x:Name="GalleryColumn"
                Width="*" />
              <ColumnDefinition
                x:Name="SplitterColumn"
                Width="0" />
              <ColumnDefinition
                x:Name="PreviewColumn"
                Width="0"
                MinWidth="0" />
            </Grid.ColumnDefinitions>
            <Grid
              x:Name="LibraryResultsPanel">
              <ListBox
                x:Name="Gallery"
                ItemsSource="{Binding Rows}"
                ItemContainerStyle="{StaticResource RowContainer}"
                VirtualizingPanel.CacheLength="1,1"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <ItemsControl
                      ItemsSource="{Binding Tiles}"
                      ItemTemplate="{StaticResource TileTemplate}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel
                            Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <ListView
                x:Name="MetadataList"
                Visibility="Collapsed"
                ItemsSource="{Binding CurrentTiles}"
                SelectionChanged="ResultSelectionChanged"
                MouseDoubleClick="ListDoubleClick"
                BorderThickness="0"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                  <GridView>
                    <GridViewColumn
                      Header="Name"
                      Width="220"
                      DisplayMemberBinding="{Binding Result.Name}" />
                    <GridViewColumn
                      Header="Type"
                      Width="85"
                      DisplayMemberBinding="{Binding KindLabel}" />
                    <GridViewColumn
                      Header="Location"
                      Width="230"
                      DisplayMemberBinding="{Binding Result.RelativePath}" />
                    <GridViewColumn
                      Header="Modified"
                      Width="120"
                      DisplayMemberBinding="{Binding DateLabel}" />
                  </GridView>
                </ListView.View>
              </ListView>
              <Grid
                x:Name="EmptyState"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                MaxWidth="390"
                Margin="16">
                <Grid.RowDefinitions>
                  <RowDefinition
                    Height="*" />
                  <RowDefinition
                    Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer
                  VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <Border
                      x:Name="EmptyIcon"
                      Background="{DynamicResource TintBrush}"
                      Width="56"
                      Height="56"
                      CornerRadius="14"
                      HorizontalAlignment="Center">
                      <TextBlock
                        Text=""
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="24"
                        Foreground="{DynamicResource AccentBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    </Border>
                    <TextBlock
                      x:Name="EmptyTitle"
                      Text="A home for everything on this drive"
                      FontSize="22"
                      FontWeight="SemiBold"
                      TextAlignment="Center"
                      TextWrapping="Wrap"
                      Margin="0,20,0,8" />
                    <TextBlock
                      x:Name="EmptyDescription"
                      Text="Prepare your photos, videos, and documents once. Find them here, even when you are offline."
                      Foreground="{DynamicResource MutedBrush}"
                      TextAlignment="Center"
                      TextWrapping="Wrap"
                      LineHeight="21" />
                  </StackPanel>
                </ScrollViewer>
                <Button
                  x:Name="EmptyAction"
                  Grid.Row="1"
                  Click="EmptyActionClick"
                  Content="Prepare this drive"
                  Style="{StaticResource PrimaryButton}"
                  HorizontalAlignment="Center"
                  Margin="0,20,0,0" />
              </Grid>
            </Grid>
            <GridSplitter
              x:Name="PreviewSplitter"
              Grid.Column="1"
              Width="12"
              HorizontalAlignment="Stretch"
              Background="Transparent"
              DragStarted="PreviewResizeStarted"
              DragCompleted="PreviewResized" />
            <Border
              Grid.Column="2"
              x:Name="PreviewPanel"
              Visibility="Collapsed"
              Style="{StaticResource PanelBorder}"
              Padding="16">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition
                    Height="Auto" />
                  <RowDefinition
                    x:Name="PreviewMediaRow"
                    Height="210" />
                  <RowDefinition
                    Height="Auto" />
                  <RowDefinition
                    Height="*" />
                  <RowDefinition
                    Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                  Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition
                      Width="Auto" />
                    <ColumnDefinition
                      Width="*" />
                    <ColumnDefinition
                      Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Button
                    x:Name="PreviewBackButton"
                    Content="Back to results"
                    Click="ClosePreviewClick"
                    Style="{StaticResource QuietButton}"
                    Visibility="Collapsed"
                    Margin="0,0,12,0" />
                  <TextBlock
                    Grid.Column="1"
                    x:Name="PreviewName"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"
                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                  <Button
                    Grid.Column="2"
                    Content=""
                    FontFamily="Segoe MDL2 Assets"
                    Click="ClosePreviewClick"
                    Style="{StaticResource IconButton}"
                    ToolTip="Close preview"
                    AutomationProperties.Name="Close preview" />
                </Grid>
                <Border
                  Grid.Row="1"
                  Background="{DynamicResource PreviewBrush}"
                  CornerRadius="8"
                  ClipToBounds="True">
                  <Grid>
                    <Image
                      x:Name="PreviewImage"
                      Stretch="Uniform" />
                    <local:VideoSurface
                      x:Name="VideoPlayer"
                      Visibility="Collapsed" />
                    <TextBlock
                      x:Name="PreviewPlaceholder"
                      Text="Preview"
                      Foreground="{DynamicResource MutedBrush}"
                      TextWrapping="Wrap"
                      TextAlignment="Center"
                      Margin="16"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
                  </Grid>
                </Border>
                <ScrollViewer
                  Grid.Row="3"
                  VerticalScrollBarVisibility="Auto"
                  Margin="0,16,0,0">
                  <StackPanel>
                    <StackPanel
                      x:Name="VideoControls"
                      Visibility="Collapsed"
                      Margin="0">
                      <WrapPanel>
                        <Button
                          Content="Play / pause"
                          Click="PlayPauseClick" />
                        <TextBlock
                          x:Name="PreviewTime"
                          Foreground="{DynamicResource MutedBrush}"
                          VerticalAlignment="Center"
                          Margin="12,0" />
                      </WrapPanel>
                      <Slider
                        x:Name="PlaybackSeek"
                        Minimum="0"
                        Maximum="1"
                        IsEnabled="False"
                        Margin="0,8,0,0"
                        PreviewMouseLeftButtonDown="SeekStarted"
                        PreviewMouseLeftButtonUp="SeekReleased"
                        PreviewKeyUp="SeekKeyReleased"
                        AutomationProperties.Name="Playback position"
                        PreviewKeyDown="SeekKeyStarted" />
                    </StackPanel>
                    <Border
                      x:Name="PossibleMatchBanner"
                      Visibility="Collapsed"
                      Background="{DynamicResource WarningTintBrush}"
                      Padding="10"
                      CornerRadius="6"
                      Margin="0,12,0,0">
                      <TextBlock
                        Text="Possible person/action match. Check this moment to confirm who is doing what."
                        Foreground="{DynamicResource WarningBrush}"
                        TextWrapping="Wrap"
                        FontSize="12" />
                    </Border>
                    <TextBlock
                      x:Name="MomentsHeading"
                      Text="Matching moments"
                      FontWeight="SemiBold"
                      Margin="0,16,0,12"
                      Visibility="Collapsed" />
                    <ItemsControl
                      x:Name="MomentsList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button
                            Click="MomentClick"
                            Tag="{Binding}"
                            HorizontalContentAlignment="Stretch"
                            Margin="0,0,0,8"
                            Padding="8"
                            ToolTip="Open this match"
                            AutomationProperties.Name="{Binding Label}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                  Width="Auto" />
                                <ColumnDefinition
                                  Width="*" />
                              </Grid.ColumnDefinitions>
                              <Image
                                Loaded="MomentThumbnailLoaded"
                                Width="64"
                                Height="48"
                                Stretch="Uniform"
                                Margin="0,0,10,0" />
                              <StackPanel
                                Grid.Column="1">
                                <TextBlock
                                  Text="{Binding Label}"
                                  FontWeight="SemiBold"
                                  FontSize="12" />
                                <TextBlock
                                  Text="{Binding Text}"
                                  Visibility="{Binding Text, Converter={StaticResource TextPresence}}"
                                  TextWrapping="Wrap"
                                  MaxHeight="58"
                                  Foreground="{DynamicResource MutedBrush}"
                                  FontSize="12"
                                  Margin="0,4,0,0" />
                              </StackPanel>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock
                      x:Name="PreviewText"
                      TextWrapping="Wrap"
                      FontSize="12"
                      LineHeight="20" />
                    <Border
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="0,1,0,0"
                      Padding="0,16,0,0"
                      Margin="0,16,0,0">
                      <StackPanel>
                        <TextBlock
                          Text="File details"
                          FontWeight="SemiBold" />
                        <TextBlock
                          x:Name="PreviewDetails"
                          Foreground="{DynamicResource MutedBrush}"
                          FontSize="12"
                          Margin="0,8,0,0"
                          TextWrapping="Wrap" />
                        <TextBlock
                          x:Name="PreviewPath"
                          TextWrapping="Wrap"
                          Foreground="{DynamicResource MutedBrush}"
                          FontSize="12"
                          Margin="0,8,0,0" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
                <WrapPanel
                  Grid.Row="4"
                  Margin="0,16,0,0">
                  <Button
                    Content="Open original"
                    Click="OpenOriginalClick"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,8,4"
                    Padding="12,8" />
                  <Button
                    Content="Show in folder"
                    Click="ShowInFolderClick"
                    Padding="12,8"
                    Margin="0,0,0,4" />
                </WrapPanel>
              </Grid>
            </Border>
          </Grid>
          <Grid
            x:Name="PaginationBar"
            Grid.Row="4"
            Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition
                Width="*" />
              <ColumnDefinition
                Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
              x:Name="ResultCount"
              Foreground="{DynamicResource MutedBrush}"
              FontSize="12"
              VerticalAlignment="Center" />
            <StackPanel
              Grid.Column="1"
              Orientation="Horizontal">
              <Button
                x:Name="PreviousPageButton"
                Content="Previous"
                Click="PreviousClick"
                IsEnabled="False"
                Padding="12,6"
                Margin="0,0,8,0" />
              <Button
                x:Name="NextPageButton"
                Content="Next"
                Click="NextClick"
                IsEnabled="False"
                Padding="12,6" />
            </StackPanel>
          </Grid>
        </Grid>
        <Grid
          x:Name="PeoplePage"
          Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition
              Height="Auto" />
            <RowDefinition
              Height="*" />
          </Grid.RowDefinitions>
          <Grid
            Margin="0,0,0,20">
            <TextBlock
              Text="People"
              Style="{StaticResource HeadingText}" />
            <Button
              Content="Add a person"
              Click="AddPersonClick"
              Style="{StaticResource PrimaryButton}"
              HorizontalAlignment="Right" />
          </Grid>
          <Grid
            Grid.Row="1"
            x:Name="PeopleArea"
            SizeChanged="PeopleSizeChanged">
            <Grid.ColumnDefinitions>
              <ColumnDefinition
                x:Name="PeopleGalleryColumn"
                Width="*" />
              <ColumnDefinition
                x:Name="PersonInspectorColumn"
                Width="0" />
            </Grid.ColumnDefinitions>
            <Grid
              x:Name="PeopleResultsPanel">
              <ListBox
                x:Name="PeopleList"
                SelectionChanged="PersonSelected"
                Visibility="Collapsed" />
              <ListBox
                x:Name="PeopleGallery"
                ItemsSource="{Binding PeopleRows}"
                ItemContainerStyle="{StaticResource RowContainer}"
                VirtualizingPanel.CacheLength="1,1"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <ItemsControl
                      ItemsSource="{Binding Tiles}"
                      ItemTemplate="{StaticResource PersonTileTemplate}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel
                            Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel
                x:Name="PeopleEmpty"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                MaxWidth="320">
                <TextBlock
                  Text="Put a name to a familiar face"
                  FontSize="20"
                  FontWeight="SemiBold"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
                <TextBlock
                  Text="Add clear reference photos to find someone across your archive. Review their matches whenever you need to."
                  TextWrapping="Wrap"
                  Foreground="{DynamicResource MutedBrush}"
                  TextAlignment="Center"
                  LineHeight="21"
                  Margin="0,12,0,20" />
                <Button
                  Content="Add a person"
                  Click="AddPersonClick"
                  HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
            <Border
              x:Name="PersonInspector"
              Grid.Column="1"
              Style="{StaticResource PanelBorder}"
              Visibility="Collapsed"
              Padding="20"
              Margin="12,0,0,0">
              <ScrollViewer
                VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <Button
                    x:Name="PersonBackButton"
                    Content="Back to people"
                    Click="ClosePersonClick"
                    Style="{StaticResource QuietButton}"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed"
                    Margin="0,0,0,12" />
                  <DockPanel>
                    <Button
                      Content=""
                      FontFamily="Segoe MDL2 Assets"
                      Style="{StaticResource IconButton}"
                      Click="ClosePersonClick"
                      DockPanel.Dock="Right"
                      HorizontalAlignment="Right"
                      AutomationProperties.Name="Close person details" />
                    <TextBlock
                      x:Name="PersonHeading"
                      Text="Add a person"
                      FontWeight="SemiBold"
                      FontSize="14"
                      VerticalAlignment="Center" />
                  </DockPanel>
                  <TextBlock
                    Text="Name"
                    Margin="0,20,0,6" />
                  <TextBox
                    x:Name="PersonName"
                    AutomationProperties.Name="Person name" />
                  <TextBlock
                    Text="Also known as"
                    Margin="0,16,0,6" />
                  <TextBox
                    x:Name="PersonAliases"
                    AutomationProperties.Name="Person aliases"
                    ToolTip="Separate names with commas" />
                  <TextBlock
                    Text="Reference photos"
                    FontWeight="SemiBold"
                    Margin="0,24,0,8" />
                  <TextBlock
                    Text="Choose clear photos with one visible face, stored on this drive."
                    Foreground="{DynamicResource MutedBrush}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    LineHeight="19" />
                  <Button
                    Content="Choose photos…"
                    Click="ReferencePhotosClick"
                    Margin="0,12,0,0" />
                  <TextBlock
                    x:Name="ReferenceCount"
                    Text="No new photos selected"
                    FontSize="12"
                    Foreground="{DynamicResource MutedBrush}"
                    Margin="0,8,0,0"
                    TextWrapping="Wrap" />
                  <Button
                    Content="Save person"
                    Click="SavePersonClick"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,24,0,0" />
                  <Border
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Margin="0,24,0,0"
                    Padding="0,16,0,0">
                    <StackPanel>
                      <Button
                        x:Name="SearchPersonButton"
                        Content="Find this person"
                        Click="SearchPersonClick"
                        IsEnabled="False" />
                      <Button
                        x:Name="ReviewFacesButton"
                        Content="Review face matches…"
                        Click="ReviewFacesClick"
                        Margin="0,8,0,0"
                        IsEnabled="False" />
                      <Button
                        x:Name="MergePersonButton"
                        Content="Merge with another person…"
                        Click="MergePersonClick"
                        Margin="0,8,0,0"
                        IsEnabled="False" />
                      <TextBlock
                        x:Name="PersonObservations"
                        FontSize="12"
                        Foreground="{DynamicResource MutedBrush}"
                        Margin="0,16,0,0"
                        TextWrapping="Wrap"
                        LineHeight="19" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>
        <Grid
          x:Name="FoldersPage"
          Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition
              Height="Auto" />
            <RowDefinition
              Height="Auto" />
            <RowDefinition
              Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <TextBlock
              Text="Folders"
              Style="{StaticResource HeadingText}" />
            <Button
              Content="Prepare more folders"
              Click="PrepareNavClick"
              HorizontalAlignment="Right" />
          </Grid>
          <TextBlock
            Text="Browse the folders included in this archive."
            Foreground="{DynamicResource MutedBrush}"
            Margin="0,8,0,24"
            Grid.Row="1" />
          <ListBox
            x:Name="FolderList"
            Grid.Row="2"
            MouseDoubleClick="FolderDoubleClick"
            HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,0,0,1"
                  Padding="8,16">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition
                        Width="40" />
                      <ColumnDefinition
                        Width="*" />
                      <ColumnDefinition
                        Width="Auto" />
                      <ColumnDefinition
                        Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                      Text=""
                      FontFamily="Segoe MDL2 Assets"
                      Foreground="{DynamicResource MutedBrush}"
                      FontSize="21"
                      VerticalAlignment="Center" />
                    <TextBlock
                      Grid.Column="1"
                      Text="{Binding RelativePath}"
                      TextTrimming="CharacterEllipsis"
                      ToolTip="{Binding RelativePath}"
                      VerticalAlignment="Center" />
                    <TextBlock
                      Grid.Column="2"
                      Text="{Binding Count, StringFormat={}{0:N0} files}"
                      Foreground="{DynamicResource MutedBrush}"
                      VerticalAlignment="Center"
                      Margin="16,0" />
                    <Button
                      Grid.Column="3"
                      Content="Browse"
                      Click="BrowseFolderClick"
                      Tag="{Binding}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock
            x:Name="FolderEmpty"
            Grid.Row="2"
            Text="Prepared folders will appear here. Choose Prepare more folders to get started."
            Foreground="{DynamicResource MutedBrush}"
            TextWrapping="Wrap"
            MaxWidth="340"
            TextAlignment="Center"
            VerticalAlignment="Center"
            HorizontalAlignment="Center" />
        </Grid>
        <Grid
          x:Name="PreparePage"
          Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition
              Height="Auto" />
            <RowDefinition
              Height="*" />
          </Grid.RowDefinitions>
          <StackPanel
            Margin="0,0,0,24">
            <TextBlock
              Text="Prepare drive"
              Style="{StaticResource HeadingText}" />
            <TextBlock
              Text="Choose what to make searchable. Everything stays on this drive."
              Foreground="{DynamicResource MutedBrush}"
              Margin="0,8,0,0"
              TextWrapping="Wrap" />
          </StackPanel>
          <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
              MaxWidth="880"
              HorizontalAlignment="Left">
              <Border
                Style="{StaticResource PanelBorder}"
                Padding="24">
                <StackPanel>
                  <TextBlock
                    Text="Folders to include"
                    FontWeight="SemiBold"
                    FontSize="14" />
                  <TextBlock
                    Text="Your originals stay in place. Files that have not changed are skipped."
                    Foreground="{DynamicResource MutedBrush}"
                    TextWrapping="Wrap"
                    Margin="0,8,0,16" />
                  <ListBox
                    x:Name="PreparationFolders"
                    MinHeight="72"
                    MaxHeight="160"
                    SelectionMode="Extended"
                    Background="{DynamicResource CanvasBrush}" />
                  <WrapPanel
                    Margin="0,12,0,24">
                    <Button
                      Content="Add folder…"
                      Click="AddFolderClick"
                      Margin="0,0,8,0" />
                    <Button
                      Content="Remove selected"
                      Click="RemoveFolderClick" />
                  </WrapPanel>
                  <Border
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,20,0,0">
                    <StackPanel>
                      <TextBlock
                        Text="Recognition options"
                        FontWeight="SemiBold"
                        FontSize="14" />
                      <WrapPanel
                        Margin="0,16,0,16">
                        <TextBlock
                          Text="Text in images"
                          VerticalAlignment="Center"
                          Margin="0,0,16,0" />
                        <ComboBox
                          x:Name="OcrLanguages"
                          Width="200"
                          SelectedIndex="0"
                          AutomationProperties.Name="OCR languages">
                          <ComboBoxItem
                            Content="English and Arabic" />
                          <ComboBoxItem
                            Content="English" />
                          <ComboBoxItem
                            Content="Arabic" />
                        </ComboBox>
                      </WrapPanel>
                      <CheckBox
                        x:Name="VerifyContents"
                        Content="Verify contents, including files with unchanged dates" />
                      <TextBlock
                        Text="Verification takes longer and checks for changes that dates may miss."
                        Foreground="{DynamicResource MutedBrush}"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Margin="24,6,0,0" />
                      <WrapPanel
                        Margin="0,24,0,0">
                        <Button
                          x:Name="StartPreparationButton"
                          Content="Prepare drive"
                          Click="StartPreparationClick"
                          Style="{StaticResource PrimaryButton}"
                          Margin="0,0,8,0" />
                        <Button
                          x:Name="PausePreparationButton"
                          Content="Pause"
                          Click="PausePreparationClick"
                          IsEnabled="False" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
              <Border
                x:Name="ProgressCard"
                Style="{StaticResource PanelBorder}"
                Padding="24"
                Margin="0,16,0,0"
                Visibility="Collapsed">
                <StackPanel>
                  <TextBlock
                    x:Name="ProgressStage"
                    Text="Preparing your archive"
                    FontSize="14"
                    FontWeight="SemiBold" />
                  <ProgressBar
                    x:Name="PreparationProgressBar"
                    Height="4"
                    Margin="0,20,0,16"
                    Foreground="{DynamicResource AccentBrush}"
                    Maximum="1" />
                  <TextBlock
                    x:Name="ProgressSummary"
                    TextWrapping="Wrap" />
                  <TextBlock
                    x:Name="ProgressPath"
                    Foreground="{DynamicResource MutedBrush}"
                    FontSize="12"
                    TextTrimming="CharacterEllipsis"
                    Margin="0,8,0,0" />
                  <TextBlock
                    x:Name="ProgressMessage"
                    Foreground="{DynamicResource MutedBrush}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Margin="0,12,0,0" />
                </StackPanel>
              </Border>
              <Expander
                Header="Available on this PC"
                Margin="0,24,0,0">
                <ItemsControl
                  x:Name="CapabilitiesList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="0,12">
                        <StackPanel>
                          <TextBlock
                            Text="{Binding Name}"
                            FontWeight="SemiBold" />
                          <TextBlock
                            Text="{Binding Detail}"
                            Foreground="{DynamicResource MutedBrush}"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Margin="0,4,0,0" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
              <Expander
                Margin="0,16,0,0">
                <Expander.Header>
                  <TextBlock
                    x:Name="IssuesHeading"
                    Text="Files needing attention" />
                </Expander.Header>
                <ItemsControl
                  x:Name="IssuesList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="0,12">
                        <StackPanel>
                          <TextBlock
                            Text="{Binding RelativePath}"
                            FontSize="12"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
                          <TextBlock
                            Text="{Binding Message}"
                            Foreground="{DynamicResource MutedBrush}"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Margin="0,4,0,0" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
              <TextBlock
                Text="Search stays available during preparation. Keep the drive connected until preparation finishes or is paused."
                Foreground="{DynamicResource MutedBrush}"
                TextWrapping="Wrap"
                Margin="0,24,0,16"
                FontSize="12" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>
    <Border
      Grid.Row="1"
      Grid.ColumnSpan="2"
      Background="{DynamicResource SurfaceBrush}"
      BorderBrush="{DynamicResource BorderBrush}"
      BorderThickness="0,1,0,0">
      <Grid
        Margin="20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition
            Width="*" />
          <ColumnDefinition
            Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
          x:Name="FooterStatus"
          Text="Local files. Local search."
          Foreground="{DynamicResource MutedBrush}"
          FontSize="11"
          VerticalAlignment="Center"
          TextTrimming="CharacterEllipsis" />
        <TextBlock
          Grid.Column="1"
          Text="Ctrl+K to search"
          Foreground="{DynamicResource MutedBrush}"
          FontSize="11"
          VerticalAlignment="Center"
          Margin="16,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</Window>
