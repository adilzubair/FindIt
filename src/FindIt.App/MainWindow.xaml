<Window
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:local="clr-namespace:FindIt.App"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
  x:Class="FindIt.App.MainWindow"
  Title="FindIt"
  FontFamily="{StaticResource AppFont}"
  FontSize="14"
  Foreground="{DynamicResource InkBrush}"
  Background="{DynamicResource CanvasBrush}"
  Width="1400"
  Height="900"
  MinWidth="880"
  MinHeight="520"
  WindowStartupLocation="CenterScreen"
  PreviewKeyDown="WindowKeyDown"
  Closing="WindowClosing"
  SizeChanged="WindowSizeChanged"
  StateChanged="WindowStateChanged"
  UseLayoutRounding="True"
  SnapsToDevicePixels="True"
  Icon="pack://application:,,,/Assets/FindIt.ico">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    <local:TextPresenceConverter x:Key="TextPresence" />
    <local:CountLabelConverter x:Key="CountLabel" />
    <local:FolderCaptionConverter x:Key="FolderCaption" />
    <local:FolderIndentConverter x:Key="FolderIndent" />
    <local:MomentTimeConverter x:Key="MomentTime" />
    <local:MomentTimeConverter x:Key="MomentTimeVisibility" />
    <Style x:Key="RowContainer" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Height" Value="{Binding Extent}" />
    </Style>
    <Style x:Key="PeopleRowContainer" TargetType="ListBoxItem" BasedOn="{StaticResource RowContainer}">
      <Setter Property="Height" Value="Auto" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <!-- Dark translucent badge drawn over thumbnails in both themes. -->
    <Style x:Key="MediaBadge" TargetType="Border">
      <Setter Property="Background" Value="#A8141414" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="Margin" Value="8" />
    </Style>

    <DataTemplate x:Key="TileTemplate">
      <Button Style="{StaticResource ResultButton}" Loaded="TileLoaded" Unloaded="TileUnloaded" Click="ResultClick" Tag="{Binding}"
              Width="{Binding TileWidth}" Margin="0,0,12,12" ToolTip="{Binding Result.RelativePath}" AutomationProperties.Name="{Binding AccessibleName}">
        <StackPanel>
          <Border CornerRadius="6" Height="{Binding ThumbnailHeight}" ClipToBounds="True">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource PreviewBrush}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsDocument}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource DocumentTintBrush}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsAudio}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AudioTintBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <Grid>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding GlyphVisibility}">
                <local:FindItIcon Kind="{Binding IconKind}" Width="40" Height="40" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ExtensionLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" HorizontalAlignment="Center" />
              </StackPanel>
              <Border Visibility="{Binding HasTextPreview, Converter={StaticResource BoolVisibility}}" Background="{DynamicResource PaperBrush}" CornerRadius="4,4,0,0" Margin="12,12,12,0" Padding="12,10,12,34" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0" ClipToBounds="True">
                <TextBlock Text="{Binding Result.Snippet}" TextWrapping="Wrap" FontSize="11" LineHeight="16" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource InkBrush}" />
              </Border>
              <Image Source="{Binding Thumbnail}">
                <Image.Style>
                  <Style TargetType="Image">
                    <Setter Property="Stretch" Value="UniformToFill" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsDocument}" Value="True">
                        <Setter Property="VerticalAlignment" Value="Top" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Image.Style>
              </Image>
              <!-- Why it matched: top-left on media; bottom-right on documents so the excerpt stays readable. -->
              <Border CornerRadius="10" Padding="8,2" MaxWidth="{Binding TileWidth}" Visibility="{Binding ReasonBadge, Converter={StaticResource TextPresence}}">
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource MediaBadge}">
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsDocument}" Value="True">
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Setter Property="VerticalAlignment" Value="Bottom" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding ReasonBadge}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis" />
              </Border>
              <Border Style="{StaticResource MediaBadge}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding IsTimedMedia, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding MediaGlyph}" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="White" />
              </Border>
              <Border CornerRadius="3" Padding="6,1" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{DynamicResource DocumentInkBrush}"
                      Visibility="{Binding IsDocument, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding ExtensionLabel}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PaperBrush}" />
              </Border>
            </Grid>
          </Border>
          <TextBlock Text="{Binding Result.Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="2,8,2,0" Height="18" />
          <TextBlock Text="{Binding MetaLabel}" FontSize="12" Foreground="{DynamicResource SubtleBrush}" TextTrimming="CharacterEllipsis" Margin="2,0,2,0" Height="16" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <DataTemplate x:Key="PersonTileTemplate">
      <Button Style="{StaticResource PersonButton}" Width="{Binding TileWidth}" Margin="0,0,12,0" Tag="{Binding}" Click="PersonTileClick"
              Loaded="PersonTileLoaded" Unloaded="PersonTileUnloaded" AutomationProperties.Name="{Binding AccessibleName}">
        <StackPanel HorizontalAlignment="Center">
          <Grid Width="112" Height="112">
            <Ellipse Fill="{DynamicResource PreviewBrush}" />
            <TextBlock Text="{Binding Initials}" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Ellipse>
              <Ellipse.Fill>
                <ImageBrush ImageSource="{Binding Portrait}" Stretch="UniformToFill" />
              </Ellipse.Fill>
            </Ellipse>
            <Ellipse StrokeThickness="3" Margin="-4">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Stroke" Value="Transparent" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                      <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
          </Grid>
          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="4,10,4,0" />
          <TextBlock Text="{Binding SeenLabel}" Style="{StaticResource CaptionText}" TextAlignment="Center" Margin="4,2,4,0" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="RootLayout" Background="{DynamicResource CanvasBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title bar: identity, the search box, drive status and caption buttons. -->
    <Grid x:Name="TitleBar">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Margin="16,0,16,0" VerticalAlignment="Center" MinWidth="200">
        <Image Source="pack://application:,,,/Assets/FindIt.png" Width="18" Height="18" />
        <TextBlock Text="FindIt" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
      <Grid x:Name="TitleSearchHost" Grid.Column="1" MaxWidth="560" Height="32" VerticalAlignment="Center" Margin="0,0,16,0">
        <TextBox x:Name="QueryBox" KeyDown="QueryKeyDown" Padding="34,0,64,0" MinHeight="32" FontSize="13" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                 AutomationProperties.Name="Search this drive" ToolTip="Describe a photo, video moment, or file. Press Enter to search." />
        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
        <TextBlock x:Name="QueryPlaceholder" Text="Search this drive" Margin="35,0,64,0" FontSize="13" Foreground="{DynamicResource SubtleBrush}" IsHitTestVisible="False" VerticalAlignment="Center">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="">
                  <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Padding="6,1" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" IsHitTestVisible="False">
          <TextBlock Text="Ctrl K" FontSize="11" Foreground="{DynamicResource SubtleBrush}" />
        </Border>
        <ProgressBar x:Name="SearchProgress" Height="2" IsIndeterminate="True" VerticalAlignment="Bottom" Margin="4,0" Visibility="Collapsed" Background="Transparent" AutomationProperties.Name="Searching" />
      </Grid>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
        <Button x:Name="DriveStatusButton" Style="{StaticResource QuietButton}" Click="DriveNavClick" Margin="0,8,8,0" Padding="10,0" MinHeight="32" Height="32"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Drive status" ToolTip="{Binding Text, ElementName=DriveLocation}">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="ConnectionDot" Fill="{DynamicResource ReadyBrush}" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock x:Name="DriveName" Text="Your archive" FontSize="12" Foreground="{DynamicResource InkBrush}" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock x:Name="ConnectionLabel" Text="Opening archive" FontSize="12" Foreground="{DynamicResource SubtleBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeClick" AutomationProperties.Name="Minimize" />
        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="MaximizeClick" AutomationProperties.Name="Maximize" />
        <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="CloseWindowClick" AutomationProperties.Name="Close" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="76" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Navigation rail -->
      <DockPanel Margin="0,0,0,10">
        <StackPanel DockPanel.Dock="Bottom">
          <ToggleButton x:Name="SettingsNav" Style="{StaticResource RailButton}" Click="SettingsNavClick" AutomationProperties.Name="Settings">
            <StackPanel>
              <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="18" />
              <TextBlock Text="Settings" Margin="0,4,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <Button x:Name="EjectButton" Style="{StaticResource RailActionButton}" Click="EjectClick" AutomationProperties.Name="Close and eject" ToolTip="Close FindIt and safely remove this drive">
            <StackPanel>
              <local:FindItIcon Kind="Eject" Width="20" Height="20" IsColorful="False" HorizontalAlignment="Center" />
              <TextBlock Text="Eject" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Margin="0,2,0,0">
          <ToggleButton x:Name="SearchNav" Style="{StaticResource RailButton}" Click="SearchNavClick" AutomationProperties.Name="Search">
            <StackPanel>
              <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="18" />
              <TextBlock Text="Search" Margin="0,4,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="BrowseNav" Style="{StaticResource RailButton}" Click="BrowseNavClick" AutomationProperties.Name="Browse">
            <StackPanel>
              <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="18" />
              <TextBlock Text="Browse" Margin="0,4,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="PeopleNav" Style="{StaticResource RailButton}" Click="PeopleNavClick" AutomationProperties.Name="People">
            <StackPanel>
              <TextBlock Text="&#xE716;" Style="{StaticResource Glyph}" FontSize="18" />
              <TextBlock Text="People" Margin="0,4,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </ToggleButton>
          <ToggleButton x:Name="DriveNav" Style="{StaticResource RailButton}" Click="DriveNavClick" AutomationProperties.Name="Drive">
            <Grid>
              <StackPanel>
                <TextBlock Text="&#xEDA2;" Style="{StaticResource Glyph}" FontSize="18" />
                <TextBlock Text="Drive" Margin="0,4,0,0" HorizontalAlignment="Center" />
              </StackPanel>
              <Ellipse x:Name="PreparingBadge" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" Visibility="Collapsed" />
            </Grid>
          </ToggleButton>
        </StackPanel>
      </DockPanel>

      <!-- Content layer -->
      <Border Grid.Column="1" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0" ClipToBounds="True">
        <Grid x:Name="ContentHost">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border x:Name="NoticeBar" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10,8,10" Margin="24,16,24,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Top" Margin="0,2,12,0" />
              <TextBlock Grid.Column="1" x:Name="NoticeText" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" MaxHeight="60" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
              <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="DismissNoticeClick" AutomationProperties.Name="Dismiss notification" ToolTip="Dismiss notification" Margin="12,0,0,0" VerticalAlignment="Top">
                <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="12" />
              </Button>
            </Grid>
          </Border>

          <Grid Grid.Row="1">
            <!-- ============ HOME ============ -->
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel MaxWidth="1000" Margin="40,56,40,48">
                <TextBlock Text="What are you looking for?" Style="{StaticResource TitleText}" />
                <TextBlock x:Name="HomeSubtitle" Text="Describe a moment, name a person, or type words you remember. Everything stays on this drive." Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,6,0,18" />
                <Grid Height="56">
                  <TextBox x:Name="HeroQueryBox" KeyDown="QueryKeyDown" FontSize="16" MinHeight="56" Padding="46,0,176,0" AutomationProperties.Name="Search this drive"
                           Text="{Binding Text, ElementName=QueryBox, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left" Margin="18,0,0,0" IsHitTestVisible="False" />
                  <TextBlock Text="Try “dog playing on the grass” or words from a document" Margin="47,0,176,0" FontSize="16" Foreground="{DynamicResource SubtleBrush}" IsHitTestVisible="False" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=HeroQueryBox}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Border Padding="6,1" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBlock Text="Ctrl K" FontSize="11" Foreground="{DynamicResource SubtleBrush}" />
                    </Border>
                    <Button x:Name="HeroSearchButton" Content="Search" Style="{StaticResource PrimaryButton}" Click="SearchClick" MinHeight="40" Padding="20,0" />
                  </StackPanel>
                </Grid>
                <WrapPanel x:Name="SuggestionPanel" Margin="0,16,0,0" />

                <Border x:Name="HomeSetupCard" Style="{StaticResource PanelBorder}" Margin="0,28,0,0" Padding="24" Visibility="Collapsed">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock x:Name="HomeSetupTitle" Text="Make this drive searchable" Style="{StaticResource HeadingText}" />
                      <TextBlock x:Name="HomeSetupText" Text="FindIt reads your folders once and saves a private search index on the drive. Your files are not moved or changed." Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button x:Name="HomeSetupButton" Grid.Column="1" Content="Get started" Style="{StaticResource PrimaryButton}" Click="DriveNavClick" VerticalAlignment="Center" Margin="24,0,0,0" />
                  </Grid>
                </Border>

                <StackPanel x:Name="HomeLibrarySections">
                  <DockPanel Margin="0,40,0,12">
                    <Button DockPanel.Dock="Right" Content="Browse all" Style="{StaticResource LinkButton}" Click="BrowseNavClick" />
                    <TextBlock Text="Recent files" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                  </DockPanel>
                  <ItemsControl x:Name="RecentList" ItemsSource="{Binding RecentTiles}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource ResultButton}" Width="148" Margin="0,0,12,12" Loaded="TileLoaded" Unloaded="TileUnloaded" Click="RecentClick" Tag="{Binding}"
                                ToolTip="{Binding Result.RelativePath}" AutomationProperties.Name="{Binding AccessibleName}">
                          <StackPanel>
                            <Border CornerRadius="6" Height="{Binding ThumbnailHeight}" ClipToBounds="True" Background="{DynamicResource PreviewBrush}">
                              <Grid>
                                <local:FindItIcon Kind="{Binding IconKind}" Width="32" Height="32" Visibility="{Binding PlaceholderVisibility}" />
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                <Border Style="{StaticResource MediaBadge}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Visibility="{Binding IsTimedMedia, Converter={StaticResource BoolVisibility}}">
                                  <TextBlock Text="{Binding MediaGlyph}" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="White" />
                                </Border>
                              </Grid>
                            </Border>
                            <TextBlock Text="{Binding Result.Name}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="2,6,2,0" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <DockPanel x:Name="HomePeopleHeader" Margin="0,28,0,12">
                    <Button DockPanel.Dock="Right" Content="See everyone" Style="{StaticResource LinkButton}" Click="PeopleNavClick" />
                    <TextBlock Text="People" Style="{StaticResource SectionText}" VerticalAlignment="Center" />
                  </DockPanel>
                  <ItemsControl x:Name="HomePeopleList" Focusable="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource PersonButton}" Width="96" Margin="0,0,8,8" Tag="{Binding}" Click="HomePersonClick" Loaded="PersonTileLoaded" Unloaded="PersonTileUnloaded"
                                AutomationProperties.Name="{Binding FindName}" ToolTip="{Binding FindName}">
                          <StackPanel HorizontalAlignment="Center">
                            <Grid Width="72" Height="72">
                              <Ellipse Fill="{DynamicResource PreviewBrush}" />
                              <TextBlock Text="{Binding Initials}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                              <Ellipse>
                                <Ellipse.Fill>
                                  <ImageBrush ImageSource="{Binding Portrait}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                              </Ellipse>
                            </Grid>
                            <TextBlock Text="{Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="2,8,2,0" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="On this drive" Style="{StaticResource SectionText}" Margin="0,28,0,12" />
                  <UniformGrid Columns="4">
                    <Button Style="{StaticResource CardButton}" Tag="1" Click="KindShortcutClick" Margin="0,0,12,0" AutomationProperties.Name="Browse photos">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource PhotoTintBrush}"><TextBlock Text="&#xEB9F;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{DynamicResource PhotoInkBrush}" /></Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="Photos" Style="{StaticResource StrongText}" /><TextBlock x:Name="PhotoCount" Text="Browse by date" Style="{StaticResource CaptionText}" /></StackPanel>
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CardButton}" Tag="2" Click="KindShortcutClick" Margin="0,0,12,0" AutomationProperties.Name="Browse videos">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource VideoTintBrush}"><TextBlock Text="&#xE714;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{DynamicResource VideoInkBrush}" /></Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="Videos" Style="{StaticResource StrongText}" /><TextBlock x:Name="VideoCount" Text="With matching moments" Style="{StaticResource CaptionText}" /></StackPanel>
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CardButton}" Tag="3" Click="KindShortcutClick" Margin="0,0,12,0" AutomationProperties.Name="Browse documents">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource DocumentTintBrush}"><TextBlock Text="&#xE8A5;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{DynamicResource DocumentInkBrush}" /></Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="Documents" Style="{StaticResource StrongText}" /><TextBlock x:Name="DocumentCount" Text="PDF, Word, Excel, text" Style="{StaticResource CaptionText}" /></StackPanel>
                      </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CardButton}" Tag="4" Click="KindShortcutClick" AutomationProperties.Name="Browse audio">
                      <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AudioTintBrush}"><TextBlock Text="&#xE8D6;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{DynamicResource AudioInkBrush}" /></Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="Audio" Style="{StaticResource StrongText}" /><TextBlock x:Name="AudioCount" Text="Speech is searchable" Style="{StaticResource CaptionText}" /></StackPanel>
                      </StackPanel>
                    </Button>
                  </UniformGrid>
                </StackPanel>
                <TextBlock x:Name="FooterStatus" Text="Local files. Local search." Style="{StaticResource CaptionText}" Margin="0,32,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </ScrollViewer>

            <!-- ============ SEARCH RESULTS / BROWSE ============ -->
            <Grid x:Name="SearchPage" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="FolderPane" Width="248" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="10,20,10,12">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="Folders" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,8" />
                  <Button x:Name="AllFoldersButton" DockPanel.Dock="Top" Style="{StaticResource NavButton}" Click="AllFoldersClick" HorizontalContentAlignment="Stretch" AutomationProperties.Name="All folders">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" x:Name="AllFoldersCount" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                      <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,0" />
                      <TextBlock Text="All files" VerticalAlignment="Center" />
                    </DockPanel>
                  </Button>
                  <ListBox x:Name="FolderList" MouseDoubleClick="FolderDoubleClick" HorizontalContentAlignment="Stretch" Margin="0,2,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource NavButton}" Click="BrowseFolderClick" Tag="{Binding}" ToolTip="{Binding RelativePath}" AutomationProperties.Name="{Binding RelativePath}"
                                HorizontalContentAlignment="Stretch" Margin="0" Padding="{Binding RelativePath, Converter={StaticResource FolderIndent}}">
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat={}{0:N0}}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <local:FindItIcon Kind="Folder" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding RelativePath, Converter={StaticResource FolderCaption}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </DockPanel>
                        </Button>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>
              <TextBlock x:Name="FolderEmpty" Grid.Column="0" Text="Prepared folders appear here." Style="{StaticResource SecondaryText}" Margin="20,80,20,0" MaxWidth="200" Visibility="Collapsed" />

              <Grid Grid.Column="1" Margin="28,22,28,12">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="SearchHeadingRow">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="SearchTitle" Text="All files" Style="{StaticResource HeadingText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="SearchSubtitle" Text="Newest first" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="DensitySelector" SelectedIndex="1" SelectionChanged="DensityChanged" MinWidth="0" Width="104" Margin="0,0,8,0" AutomationProperties.Name="Thumbnail size" ToolTip="Thumbnail size">
                      <ComboBoxItem Content="Small" />
                      <ComboBoxItem Content="Medium" />
                      <ComboBoxItem Content="Large" />
                    </ComboBox>
                    <Border Style="{StaticResource SegmentGroup}">
                      <StackPanel Orientation="Horizontal">
                        <Button x:Name="GridViewButton" Click="GridViewClick" Style="{StaticResource SegmentButton}" ToolTip="Grid" AutomationProperties.Name="Gallery view">
                          <local:FindItIcon Kind="Gallery" Width="16" Height="16" IsColorful="False" />
                        </Button>
                        <Button x:Name="ListViewButton" Click="ListViewClick" Style="{StaticResource SegmentButton}" ToolTip="List" AutomationProperties.Name="List view">
                          <local:FindItIcon Kind="List" Width="16" Height="16" IsColorful="False" />
                        </Button>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>

                <WrapPanel x:Name="FilterBar" Grid.Row="1" Margin="0,14,0,10">
                  <Border Style="{StaticResource SegmentGroup}" Margin="0,0,8,6">
                    <StackPanel Orientation="Horizontal">
                      <ToggleButton x:Name="AllTab" Tag="0" Content="All" IsChecked="True" Click="TypeTabClick" Style="{StaticResource TypeTab}" />
                      <ToggleButton x:Name="PhotosTab" Tag="1" Content="Photos" Click="TypeTabClick" Style="{StaticResource TypeTab}" />
                      <ToggleButton x:Name="VideosTab" Tag="2" Content="Videos" Click="TypeTabClick" Style="{StaticResource TypeTab}" />
                      <ToggleButton x:Name="DocumentsTab" Tag="3" Content="Documents" Click="TypeTabClick" Style="{StaticResource TypeTab}" />
                      <ToggleButton x:Name="AudioTab" Tag="4" Content="Audio" Click="TypeTabClick" Style="{StaticResource TypeTab}" />
                    </StackPanel>
                  </Border>
                  <Button x:Name="FiltersButton" Click="FiltersClick" Padding="10,0,12,0" Margin="0,0,8,6" AutomationProperties.Name="Filters">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE71C;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0" />
                      <TextBlock Text="Filters" FontSize="13" VerticalAlignment="Center" />
                      <TextBlock x:Name="FilterCountText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <CheckBox x:Name="ExactFilter" Content="Exact words" Style="{StaticResource ChipSwitch}" Checked="ExactChanged" Unchecked="ExactChanged" Margin="0,0,8,6"
                            AutomationProperties.Name="Match exact words" ToolTip="Only show files containing these exact words" />
                  <WrapPanel x:Name="ActiveFilterPanel" Visibility="Collapsed" VerticalAlignment="Center" />
                </WrapPanel>
                <ComboBox x:Name="KindFilter" Grid.Row="1" Visibility="Collapsed" SelectionChanged="FilterChanged">
                  <ComboBoxItem Content="All" />
                  <ComboBoxItem Content="Photos" />
                  <ComboBoxItem Content="Videos" />
                  <ComboBoxItem Content="Documents" />
                  <ComboBoxItem Content="Audio" />
                </ComboBox>
                <Popup x:Name="FiltersPopup" PlacementTarget="{Binding ElementName=FiltersButton}" Placement="Custom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="None">
                  <Border Style="{StaticResource PanelBorder}" Padding="20" Width="328" Margin="8,8,8,16">
                    <Border.Effect>
                      <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.18" />
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380" x:Name="FilterScroll">
                      <StackPanel>
                        <TextBlock Text="Filter results" Style="{StaticResource StrongText}" Margin="0,0,0,16" />
                        <TextBlock Text="Date" FontSize="13" Margin="0,0,0,6" />
                        <ComboBox x:Name="DateFilter" SelectionChanged="FilterChanged" AutomationProperties.Name="Date">
                          <ComboBoxItem Content="Any date" />
                          <ComboBoxItem Content="Last 30 days" />
                          <ComboBoxItem Content="This year" />
                          <ComboBoxItem Content="Date range…" />
                        </ComboBox>
                        <StackPanel x:Name="DateRangePanel" Visibility="Collapsed" Margin="0,8,0,0">
                          <DatePicker x:Name="AfterDate" SelectedDateChanged="DateRangeChanged" AutomationProperties.Name="From date" ToolTip="From date, inclusive" />
                          <TextBlock Text="to" FontSize="13" Margin="0,4" />
                          <DatePicker x:Name="BeforeDate" SelectedDateChanged="DateRangeChanged" AutomationProperties.Name="To date" ToolTip="To date, inclusive" />
                        </StackPanel>
                        <TextBlock Text="Folder" FontSize="13" Margin="0,16,0,6" />
                        <ComboBox x:Name="FolderFilter" DisplayMemberPath="Label" SelectionChanged="FilterChanged" AutomationProperties.Name="Folder filter" />
                        <TextBlock Text="Person" FontSize="13" Margin="0,16,0,6" />
                        <ComboBox x:Name="PersonFilter" DisplayMemberPath="Name" SelectionChanged="FilterChanged" AutomationProperties.Name="Person filter" />
                        <Button Content="Clear filters" Click="ClearFiltersClick" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-8,16,0,0" />
                      </StackPanel>
                    </ScrollViewer>
                  </Border>
                </Popup>

                <Grid Grid.Row="2" x:Name="ResultsArea" SizeChanged="ResultsSizeChanged">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="GalleryColumn" Width="*" />
                    <ColumnDefinition x:Name="SplitterColumn" Width="0" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="0" MinWidth="0" />
                  </Grid.ColumnDefinitions>
                  <Grid x:Name="LibraryResultsPanel">
                    <local:RowGallery x:Name="Gallery" ItemsSource="{Binding Rows}" ItemContainerStyle="{StaticResource RowContainer}" VirtualizingPanel.CacheLength="1,1"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto" SizeChanged="GallerySizeChanged" Style="{StaticResource {x:Type ListBox}}" Padding="4,4,0,0"
                                      AutomationProperties.Name="Files. Use arrow keys to move between files.">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <local:PresentationItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                              <Style TargetType="ContentPresenter">
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                              </Style>
                            </ItemsControl.ItemContainerStyle>
                          </local:PresentationItemsControl>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </local:RowGallery>
                    <Border x:Name="MetadataListFrame" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4,0,4,4"
                            Visibility="{Binding Visibility, ElementName=MetadataList}">
                      <ListView x:Name="MetadataList" Visibility="Collapsed" ItemsSource="{Binding CurrentTiles}" SelectionChanged="ResultSelectionChanged" MouseDoubleClick="ListDoubleClick"
                                BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.View>
                          <GridView>
                            <GridViewColumn Header="Name" Width="260">
                              <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                  <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding KindGlyph}" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding Result.Name}" ToolTip="{Binding Result.Name}" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                  </StackPanel>
                                </DataTemplate>
                              </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Why it matched" Width="220">
                              <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding ReasonLong}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                              </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Location" Width="230">
                              <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding Result.RelativePath}" ToolTip="{Binding Result.RelativePath}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                              </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Modified" Width="120">
                              <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                  <TextBlock Text="{Binding DateLabel}" Foreground="{DynamicResource MutedBrush}" />
                                </DataTemplate>
                              </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                          </GridView>
                        </ListView.View>
                        <ListView.ItemContainerStyle>
                          <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                            <Setter Property="ToolTip" Value="{Binding Result.RelativePath}" />
                          </Style>
                        </ListView.ItemContainerStyle>
                      </ListView>
                    </Border>
                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Margin="24">
                      <Border x:Name="EmptyIcon" Background="{DynamicResource TintBrush}" Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <TextBlock x:Name="EmptyGlyph" Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" />
                      </Border>
                      <TextBlock x:Name="EmptyTitle" Text="Your archive, ready to discover" Style="{StaticResource HeadingText}" TextAlignment="Center" TextWrapping="Wrap" />
                      <TextBlock x:Name="EmptyDescription" Text="Choose folders to make your photos, videos and documents searchable offline." Style="{StaticResource SecondaryText}" FontSize="14" TextAlignment="Center" Margin="0,6,0,0" />
                      <Border x:Name="EmptySuggestionsCard" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,18,0,0" Visibility="Collapsed">
                        <StackPanel x:Name="EmptySuggestions" />
                      </Border>
                      <Button x:Name="EmptyAction" Click="EmptyActionClick" Content="Prepare this drive" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,20,0,0" />
                    </StackPanel>
                  </Grid>
                  <GridSplitter x:Name="PreviewSplitter" Grid.Column="1" Width="16" HorizontalAlignment="Stretch" Background="Transparent" DragStarted="PreviewResizeStarted" DragCompleted="PreviewResized" />
                  <Border x:Name="PreviewScrim" Grid.ColumnSpan="3" Background="{DynamicResource ScrimBrush}" Visibility="Collapsed" MouseLeftButtonDown="PreviewScrimClick" CornerRadius="8" />

                  <!-- Preview -->
                  <Border Grid.Column="2" x:Name="PreviewPanel" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="PreviewMediaRow" Height="210" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid Margin="16,12,8,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                          <Button x:Name="PreviewBackButton" Click="ClosePreviewClick" Style="{StaticResource QuietButton}" Visibility="Collapsed" Margin="-6,0,8,0" Padding="6,0" AutomationProperties.Name="Back to results">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&#xE72B;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,6,0" />
                              <TextBlock Text="Results" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Image x:Name="EvidencePortrait" Width="32" Height="32" Stretch="UniformToFill" Visibility="Collapsed" Margin="0,0,10,0">
                            <Image.Clip>
                              <EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16" />
                            </Image.Clip>
                          </Image>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock x:Name="PreviewName" Style="{StaticResource StrongText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                          <TextBlock x:Name="PreviewDetails" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                          <Button x:Name="PreviewPreviousButton" Click="PreviewPreviousClick" Style="{StaticResource IconButton}" AutomationProperties.Name="Previous result" ToolTip="Previous result">
                            <TextBlock Text="&#xE76B;" Style="{StaticResource Glyph}" FontSize="12" />
                          </Button>
                          <Button x:Name="PreviewNextButton" Click="PreviewNextClick" Style="{StaticResource IconButton}" AutomationProperties.Name="Next result" ToolTip="Next result">
                            <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="12" />
                          </Button>
                          <Button Click="ClosePreviewClick" Style="{StaticResource IconButton}" ToolTip="Close preview" AutomationProperties.Name="Close preview">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="12" />
                          </Button>
                        </StackPanel>
                      </Grid>
                      <Border Grid.Row="1" Margin="16,0,16,0" Background="{DynamicResource PreviewBrush}" CornerRadius="6" ClipToBounds="True">
                        <Grid>
                          <Image x:Name="PreviewImage" Stretch="Uniform" />
                          <local:VideoSurface x:Name="VideoPlayer" Visibility="Collapsed" />
                          <TextBlock x:Name="PreviewPlaceholder" Text="Preview" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0" Padding="16,0,16,12">
                        <StackPanel>
                          <StackPanel x:Name="VideoControls" Visibility="Collapsed">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                              </Grid.ColumnDefinitions>
                              <Button x:Name="PlayPauseButton" Content="&#xE768;" Click="PlayPauseClick" FontFamily="{StaticResource IconFont}" FontSize="14" Width="36" Height="36" Padding="0" AutomationProperties.Name="Play playback" ToolTip="Play or pause" />
                              <Grid Grid.Column="1" Margin="4,0">
                                <Slider x:Name="PlaybackSeek" Minimum="0" Maximum="1" IsEnabled="False" VerticalAlignment="Center" PreviewMouseLeftButtonDown="SeekStarted" PreviewMouseLeftButtonUp="SeekReleased"
                                        PreviewKeyUp="SeekKeyReleased" PreviewKeyDown="SeekKeyStarted" AutomationProperties.Name="Playback position" />
                                <Canvas x:Name="MomentMarkers" Margin="10,0" Height="16" VerticalAlignment="Center" />
                              </Grid>
                              <TextBlock x:Name="PreviewTime" Grid.Column="2" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </Grid>
                          </StackPanel>
                          <ItemsControl x:Name="PersonEvidenceFaces" Visibility="Collapsed" Margin="0,12,0,0" AutomationProperties.Name="Sampled face evidence">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Grid Margin="0,0,0,8" AutomationProperties.Name="{Binding AccessibleName}">
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <Ellipse Width="40" Height="40" Fill="{DynamicResource PreviewBrush}" />
                                  <Ellipse Width="40" Height="40">
                                    <Ellipse.Fill>
                                      <ImageBrush ImageSource="{Binding Portrait}" Stretch="UniformToFill" />
                                    </Ellipse.Fill>
                                  </Ellipse>
                                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                                  </StackPanel>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Border x:Name="PossibleMatchBanner" Visibility="Collapsed" Background="{DynamicResource TintBrush}" Padding="12,10" CornerRadius="6" Margin="0,12,0,0">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Top" Margin="0,1,10,0" />
                              <TextBlock Grid.Column="1" Text="Possible match. Faces are suggestions from sampled frames; watch the moment to confirm who is there and what they are doing." TextWrapping="Wrap" FontSize="12" LineHeight="17" Foreground="{DynamicResource MutedBrush}" />
                            </Grid>
                          </Border>
                          <TextBlock x:Name="PersonEvidenceDetails" Visibility="Collapsed" TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,10,0,0" />
                          <TextBlock x:Name="MomentsHeading" Text="Matching moments" Style="{StaticResource StrongText}" Margin="0,16,0,8" Visibility="Collapsed" />
                          <ItemsControl x:Name="MomentsList">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Button Click="MomentClick" Tag="{Binding}" Style="{StaticResource QuietButton}" Foreground="{DynamicResource InkBrush}" HorizontalContentAlignment="Stretch" Margin="0,0,0,2" Padding="8" ToolTip="Open this moment" AutomationProperties.Name="{Binding Label}">
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="64" Height="40" CornerRadius="4" Background="{DynamicResource PreviewBrush}" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Top">
                                      <Grid>
                                        <Image Loaded="MomentThumbnailLoaded" Stretch="UniformToFill" />
                                        <Border Style="{StaticResource MediaBadge}" Margin="3" Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding Converter={StaticResource MomentTimeVisibility}}">
                                          <TextBlock Text="{Binding Converter={StaticResource MomentTime}}" FontSize="10" Foreground="White" />
                                        </Border>
                                      </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                      <TextBlock Text="{Binding Converter={StaticResource MomentTime}, ConverterParameter=title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                      <TextBlock Text="{Binding Text}" Visibility="{Binding Text, Converter={StaticResource TextPresence}}" TextWrapping="Wrap" MaxHeight="50" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                  </Grid>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <Border x:Name="PreviewTextCard" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="20,18" Margin="0,12,0,0"
                                  Visibility="{Binding Visibility, ElementName=PreviewText}">
                            <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontFamily="Georgia, Times New Roman" FontSize="13" LineHeight="21" />
                          </Border>
                          <StackPanel Margin="0,18,0,0">
                            <TextBlock Text="Details" Style="{StaticResource StrongText}" Margin="0,0,0,6" />
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                              </Grid.RowDefinitions>
                              <TextBlock Text="Location" FontSize="13" Foreground="{DynamicResource MutedBrush}" />
                              <TextBlock x:Name="PreviewPath" Grid.Column="1" FontSize="13" TextWrapping="Wrap" />
                              <TextBlock Grid.Row="1" Text="Modified" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                              <TextBlock x:Name="PreviewDate" Grid.Row="1" Grid.Column="1" FontSize="13" Margin="0,4,0,0" />
                            </Grid>
                          </StackPanel>
                        </StackPanel>
                      </ScrollViewer>
                      <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Click="CopyPathClick" Style="{StaticResource IconButton}" AutomationProperties.Name="Copy file path" ToolTip="Copy file path">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="14" />
                          </Button>
                          <WrapPanel>
                            <Button x:Name="OpenOriginalButton" Click="OpenOriginalClick" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Padding="14,0">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0" Foreground="{DynamicResource AccentButtonForegroundBrush}" />
                                <TextBlock Text="Open" VerticalAlignment="Center" />
                              </StackPanel>
                            </Button>
                            <Button Content="Show in folder" Click="ShowInFolderClick" />
                          </WrapPanel>
                        </DockPanel>
                      </Border>
                    </Grid>
                  </Border>
                </Grid>

                <Grid x:Name="PaginationBar" Grid.Row="3" Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="ResultCount" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SearchMoreButton" Content="Search deeper" Click="SearchMoreClick" Style="{StaticResource LinkButton}" ToolTip="Look further than the closest matches. This starts a fresh, larger search." Visibility="Collapsed" Margin="0,0,8,0" />
                    <Button x:Name="PreviousPageButton" Click="PreviousClick" IsEnabled="False" Padding="10,0" Margin="0,0,6,0" AutomationProperties.Name="Previous page">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE76B;" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,6,0" />
                        <TextBlock Text="Previous" FontSize="13" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button x:Name="NextPageButton" Click="NextClick" IsEnabled="False" Padding="10,0" AutomationProperties.Name="Next page">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Next" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="11" Margin="6,0,0,0" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
              </Grid>
            </Grid>

            <!-- ============ PEOPLE ============ -->
            <Grid x:Name="PeoplePage" Visibility="Collapsed">
              <Grid x:Name="PeopleArea" SizeChanged="PeopleSizeChanged">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="PeopleGalleryColumn" Width="*" />
                  <ColumnDefinition x:Name="PersonInspectorColumn" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="PeopleResultsPanel" Margin="40,28,28,0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Grid Margin="0,0,12,20">
                    <StackPanel>
                      <TextBlock Text="People" Style="{StaticResource TitleText}" />
                      <TextBlock Text="Faces found on this drive. Name a group to search for that person. Names stay on the drive." Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Click="AddPersonClick" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Content="Add a person" />
                  </Grid>
                  <ListBox x:Name="PeopleList" SelectionChanged="PersonSelected" Visibility="Collapsed" />
                  <local:RowGallery Grid.Row="1" x:Name="PeopleGallery" ItemsSource="{Binding PeopleRows}" ItemContainerStyle="{StaticResource PeopleRowContainer}" VirtualizingPanel.CacheLength="1,1"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto" SizeChanged="PeopleSizeChanged" Style="{StaticResource {x:Type ListBox}}"
                                    AutomationProperties.Name="People. Use arrow keys to move between people.">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <local:PresentationItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource PersonTileTemplate}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                              <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                            </Style>
                          </ItemsControl.ItemContainerStyle>
                        </local:PresentationItemsControl>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </local:RowGallery>
                  <StackPanel Grid.Row="1" x:Name="PeopleEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                    <Border Background="{DynamicResource TintBrush}" Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Center" Margin="0,0,0,18">
                      <TextBlock Text="&#xE716;" Style="{StaticResource Glyph}" FontSize="28" Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                    <TextBlock Text="Put a name to a familiar face" Style="{StaticResource HeadingText}" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="Add clear reference photos to find someone across this drive. Faces found while preparing also appear here." Style="{StaticResource SecondaryText}" FontSize="14" TextAlignment="Center" Margin="0,6,0,20" />
                    <Button Content="Add a person" Click="AddPersonClick" HorizontalAlignment="Center" />
                  </StackPanel>
                </Grid>

                <!-- Person page -->
                <ScrollViewer x:Name="PersonInspector" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel MaxWidth="1040" Margin="40,20,40,40">
                    <Button x:Name="PersonBackButton" Click="ClosePersonClick" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Margin="-10,0,0,12" Padding="8,0" AutomationProperties.Name="Back to people">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="People" FontSize="13" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid Width="96" Height="96" Margin="0,0,24,0">
                        <Ellipse Fill="{DynamicResource PreviewBrush}" />
                        <TextBlock x:Name="PersonInitials" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse>
                          <Ellipse.Fill>
                            <ImageBrush x:Name="PersonAvatar" Stretch="UniformToFill" />
                          </Ellipse.Fill>
                        </Ellipse>
                      </Grid>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="PersonHeading" Text="Add a person" Style="{StaticResource TitleText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock x:Name="PersonObservations" Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,4,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SearchPersonButton" Content="Find this person" Click="SearchPersonClick" Style="{StaticResource PrimaryButton}" IsEnabled="False" Margin="0,0,8,0" />
                        <Button x:Name="MergePersonButton" Content="Merge…" Click="MergePersonClick" IsEnabled="False" ToolTip="Merge with another person" />
                      </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource PanelBorder}" Margin="0,28,0,0" Padding="24">
                      <StackPanel>
                        <TextBlock Text="Details" Style="{StaticResource SectionText}" />
                        <Grid Margin="0,16,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <Label Content="_Name" Target="{Binding ElementName=PersonName}" Padding="0" Margin="0,0,0,6" FontSize="13" Foreground="{DynamicResource InkBrush}" />
                            <TextBox x:Name="PersonName" AutomationProperties.Name="Person name" />
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <Label Content="_Also known as" Target="{Binding ElementName=PersonAliases}" Padding="0" Margin="0,0,0,6" FontSize="13" Foreground="{DynamicResource InkBrush}" />
                            <TextBox x:Name="PersonAliases" AutomationProperties.Name="Person aliases" ToolTip="Separate names with commas" />
                          </StackPanel>
                        </Grid>
                        <TextBlock Text="Reference photos" FontSize="13" Margin="0,18,0,4" />
                        <TextBlock Text="Clear photos with one visible face work best. Choose photos stored on this drive." Style="{StaticResource SecondaryText}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                          <Button Click="ReferencePhotosClick" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                              <TextBlock Text="Choose photos…" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <TextBlock x:Name="ReferenceCount" Text="No new photos selected" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Content="Save person" Click="SavePersonClick" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,22,0,0" />
                      </StackPanel>
                    </Border>

                    <Border x:Name="PersonReviewCard" Style="{StaticResource PanelBorder}" Margin="0,16,0,0" Padding="24" Visibility="Collapsed">
                      <StackPanel>
                        <DockPanel>
                          <Button x:Name="ReviewFacesButton" DockPanel.Dock="Right" Content="Review all matches…" Click="ReviewFacesClick" IsEnabled="False" />
                          <StackPanel>
                            <TextBlock Text="Suggested matches" Style="{StaticResource SectionText}" />
                            <TextBlock x:Name="PersonReviewHint" Text="Confirm or reject faces. Your answers stay on this drive and make person searches more reliable." Style="{StaticResource SecondaryText}" Margin="0,4,12,0" />
                          </StackPanel>
                        </DockPanel>
                        <ItemsControl x:Name="PersonSuggestionList" Margin="0,16,0,0" Focusable="False">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Width="168" Margin="0,0,12,12" CornerRadius="8" BorderThickness="1" Background="{DynamicResource SurfaceBrush}" ClipToBounds="True" AutomationProperties.Name="{Binding AccessibleName}">
                                <Border.Style>
                                  <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                    <Setter Property="Opacity" Value="1" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Decision}" Value="Confirmed">
                                        <Setter Property="BorderBrush" Value="{DynamicResource ReadyBrush}" />
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding Decision}" Value="Rejected">
                                        <Setter Property="Opacity" Value="0.55" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                                <StackPanel>
                                  <Grid Height="140" Background="{DynamicResource PreviewBrush}">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    <Border Style="{StaticResource MediaBadge}" CornerRadius="10" Padding="8,1" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding DecisionLabel, Converter={StaticResource TextPresence}}">
                                      <TextBlock Text="{Binding DecisionLabel}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                    </Border>
                                  </Grid>
                                  <StackPanel Margin="10,8,10,4">
                                    <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Observation.RelativePath}" />
                                    <TextBlock Text="{Binding When}" Style="{StaticResource CaptionText}" FontSize="11" />
                                  </StackPanel>
                                  <UniformGrid Columns="2" Margin="10,4,10,10">
                                    <Button Tag="{Binding}" Click="ConfirmSuggestionClick" Margin="0,0,3,0" MinHeight="30" Padding="4,0" AutomationProperties.Name="{Binding ConfirmName}" ToolTip="{Binding ConfirmName}">
                                      <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Yes" FontSize="12" VerticalAlignment="Center" />
                                      </StackPanel>
                                    </Button>
                                    <Button Tag="{Binding}" Click="RejectSuggestionClick" Margin="3,0,0,0" MinHeight="30" Padding="4,0" AutomationProperties.Name="{Binding RejectName}" ToolTip="{Binding RejectName}">
                                      <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,6,0" />
                                        <TextBlock Text="No" FontSize="12" VerticalAlignment="Center" />
                                      </StackPanel>
                                    </Button>
                                  </UniformGrid>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="PersonSuggestionEmpty" Text="No suggestions to review right now." Style="{StaticResource SecondaryText}" Margin="0,8,0,0" Visibility="Collapsed" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Grid>

            <!-- ============ DRIVE ============ -->
            <ScrollViewer x:Name="DrivePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel MaxWidth="880" Margin="40,32,40,48">
                <Grid Margin="0,0,0,24">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="56" Height="56" CornerRadius="12" Background="{DynamicResource TintBrush}" Margin="0,0,16,0">
                    <TextBlock Text="&#xEDA2;" Style="{StaticResource Glyph}" FontSize="26" Foreground="{DynamicResource AccentTextBrush}" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="DriveTitle" Text="Your archive" Style="{StaticResource TitleText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                      <Ellipse x:Name="DriveStatusDot" Width="8" Height="8" Fill="{DynamicResource ReadyBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                      <TextBlock x:Name="DriveStatusText" Text="Opening archive" Style="{StaticResource SecondaryText}" FontSize="13" />
                    </StackPanel>
                    <TextBlock x:Name="DriveLocation" Style="{StaticResource CaptionText}" Margin="16,2,0,0" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>

                <Border x:Name="WelcomeCard" Style="{StaticResource PanelBorder}" Padding="24" Margin="0,0,0,16" Visibility="Collapsed">
                  <StackPanel>
                    <TextBlock Text="Make this drive searchable" Style="{StaticResource HeadingText}" />
                    <TextBlock Text="FindIt reads your folders once and saves a private search index on the drive. Your files are not moved or changed." Style="{StaticResource SecondaryText}" FontSize="14" Margin="0,4,0,16" />
                    <UniformGrid Columns="3">
                      <Border Background="{DynamicResource HoverBrush}" CornerRadius="6" Padding="14" Margin="0,0,12,0">
                        <StackPanel><TextBlock Text="1" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock Text="Pick folders" Style="{StaticResource StrongText}" /><TextBlock Text="Choose folders stored on this drive." Style="{StaticResource SecondaryText}" /></StackPanel>
                      </Border>
                      <Border Background="{DynamicResource HoverBrush}" CornerRadius="6" Padding="14" Margin="0,0,12,0">
                        <StackPanel><TextBlock Text="2" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock Text="Prepare once" Style="{StaticResource StrongText}" /><TextBlock Text="Best on a fast PC. Pause and resume anytime." Style="{StaticResource SecondaryText}" /></StackPanel>
                      </Border>
                      <Border Background="{DynamicResource HoverBrush}" CornerRadius="6" Padding="14">
                        <StackPanel><TextBlock Text="3" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock Text="Search anywhere" Style="{StaticResource StrongText}" /><TextBlock Text="Plug in on any Windows PC. No internet needed." Style="{StaticResource SecondaryText}" /></StackPanel>
                      </Border>
                    </UniformGrid>
                  </StackPanel>
                </Border>

                <Border x:Name="ProgressCard" Style="{StaticResource PanelBorder}" Padding="24" Margin="0,0,0,16" Visibility="Collapsed">
                  <StackPanel>
                    <DockPanel>
                      <Button x:Name="PausePreparationButton" DockPanel.Dock="Right" Content="Pause" Click="PausePreparationClick" IsEnabled="False" VerticalAlignment="Top" />
                      <StackPanel>
                        <TextBlock x:Name="ProgressStage" Text="Preparing your archive" Style="{StaticResource SectionText}" />
                        <TextBlock x:Name="ProgressSummary" Style="{StaticResource SecondaryText}" FontSize="13" Margin="0,2,12,0" />
                      </StackPanel>
                    </DockPanel>
                    <ProgressBar x:Name="PreparationProgressBar" Height="6" Margin="0,16,0,14" Maximum="1" AutomationProperties.Name="Preparation progress" />
                    <UniformGrid x:Name="StageStrip" Columns="5" />
                    <TextBlock x:Name="ProgressPath" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" Margin="0,14,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="ProgressMessage" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
                    <TextBlock Text="Search keeps working with files that are already prepared. Keep the drive connected until this finishes or you pause." Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
                  </StackPanel>
                </Border>

                <Border x:Name="PreparedFoldersCard" Style="{StaticResource PanelBorder}" Padding="0" Margin="0,0,0,16">
                  <StackPanel>
                    <StackPanel Margin="20,16,20,12">
                      <TextBlock Text="Searchable now" Style="{StaticResource StrongText}" />
                      <TextBlock Text="Folders already prepared on this drive." Style="{StaticResource SecondaryText}" />
                    </StackPanel>
                    <ItemsControl x:Name="DriveFolderList" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
                            <DockPanel>
                              <Border DockPanel.Dock="Right" Background="{DynamicResource ReadyTintBrush}" CornerRadius="10" Padding="8,1" VerticalAlignment="Center">
                                <TextBlock Text="Prepared" FontSize="12" Foreground="{DynamicResource ReadyBrush}" />
                              </Border>
                              <local:FindItIcon Kind="Folder" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                              <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding RelativePath}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Count, Converter={StaticResource CountLabel}, ConverterParameter=file}" Style="{StaticResource CaptionText}" />
                              </StackPanel>
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorder}" Padding="0" Margin="0,0,0,16">
                  <StackPanel>
                    <DockPanel Margin="20,16,20,12">
                      <Button x:Name="AddPreparationFolderButton" DockPanel.Dock="Right" Click="AddFolderClick" VerticalAlignment="Center" AutomationProperties.Name="Add folder">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,8,0" />
                          <TextBlock Text="Add folder…" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <StackPanel>
                        <TextBlock x:Name="PrepareFoldersTitle" Text="Folders to prepare" Style="{StaticResource StrongText}" />
                        <TextBlock Text="Originals stay where they are. Unchanged files are skipped, so updates are quick." Style="{StaticResource SecondaryText}" Margin="0,0,12,0" />
                      </StackPanel>
                    </DockPanel>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                      <Grid>
                        <ListBox x:Name="PreparationFolders" MinHeight="44" MaxHeight="180" SelectionMode="Extended" ScrollViewer.VerticalScrollBarVisibility="Auto">
                          <ListBox.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Orientation="Horizontal" Margin="12,8">
                                <local:FindItIcon Kind="Folder" Width="18" Height="18" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </DataTemplate>
                          </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="PreparationFoldersEmpty" Text="No folders chosen yet. Add the folders on this drive that you want to search." Style="{StaticResource SecondaryText}" FontSize="13" Margin="12,12" IsHitTestVisible="False" />
                      </Grid>
                    </Border>
                    <Button x:Name="RemovePreparationFolderButton" Content="Remove selected" Click="RemoveFolderClick" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="12,0,0,10" />
                    <DockPanel Margin="20,12,20,12">
                      <ComboBox x:Name="OcrLanguages" DockPanel.Dock="Right" Width="200" SelectedIndex="0" AutomationProperties.Name="OCR languages" VerticalAlignment="Center">
                        <ComboBoxItem Content="English and Arabic" />
                        <ComboBoxItem Content="English" />
                        <ComboBoxItem Content="Arabic" />
                      </ComboBox>
                      <StackPanel>
                        <TextBlock Text="Read text in images and scans" FontSize="13" FontWeight="Medium" />
                        <TextBlock Text="Languages for photos of documents, screenshots and scanned PDFs." Style="{StaticResource SecondaryText}" Margin="0,0,12,0" />
                      </StackPanel>
                    </DockPanel>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                      <DockPanel>
                        <CheckBox x:Name="VerifyContents" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Padding="0" AutomationProperties.Name="Check every file's contents" />
                        <StackPanel>
                          <TextBlock Text="Check every file’s contents" FontSize="13" FontWeight="Medium" />
                          <TextBlock Text="Slower. Catches files that changed without a new date." Style="{StaticResource SecondaryText}" Margin="0,0,12,0" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                  <Button x:Name="StartPreparationButton" Content="Prepare drive" Click="StartPreparationClick" Style="{StaticResource PrimaryButton}" MinHeight="36" Padding="18,0" />
                  <TextBlock x:Name="PrepareHint" Text="Takes a while for large drives. You can pause and resume." Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource PanelBorder}">
                    <StackPanel>
                      <TextBlock Text="Available on this PC" Style="{StaticResource StrongText}" Margin="0,0,0,8" />
                      <ItemsControl x:Name="CapabilitiesList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Margin="0,4" ToolTip="{Binding Detail}">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <Ellipse Width="8" Height="8" Margin="0,6,10,0" VerticalAlignment="Top">
                                <Ellipse.Style>
                                  <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource ReadyBrush}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Available}" Value="False">
                                        <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Ellipse.Style>
                              </Ellipse>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontSize="13" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                    <StackPanel>
                      <TextBlock x:Name="IssuesHeading" Text="No files need attention" Style="{StaticResource StrongText}" Margin="0,0,0,8" />
                      <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="IssuesList" Focusable="False">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding RelativePath}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativePath}" />
                                <TextBlock Text="{Binding Message}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </StackPanel>
                  </Border>
                </Grid>

                <Border Style="{StaticResource PanelBorder}" Margin="0,16,0,0">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Click="EjectClick" VerticalAlignment="Center" AutomationProperties.Name="Close and eject">
                      <StackPanel Orientation="Horizontal">
                        <local:FindItIcon Kind="Eject" Width="16" Height="16" IsColorful="False" Margin="0,0,8,0" />
                        <TextBlock Text="Close and eject" FontSize="14" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <StackPanel>
                      <TextBlock Text="Done for now?" Style="{StaticResource StrongText}" />
                      <TextBlock Text="Close FindIt and safely remove the drive. Your index and people stay on the drive." Style="{StaticResource SecondaryText}" Margin="0,0,12,0" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- ============ SETTINGS ============ -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel MaxWidth="880" Margin="40,32,40,48">
                <TextBlock Text="Settings" Style="{StaticResource TitleText}" Margin="0,0,0,24" />
                <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource StrongText}" />
                    <TextBlock Text="Choose how FindIt looks on this PC." Style="{StaticResource SecondaryText}" Margin="0,0,0,14" />
                    <UniformGrid Columns="3">
                      <RadioButton x:Name="ThemeSystemOption" GroupName="Theme" Tag="System" Style="{StaticResource CardRadio}" Checked="ThemeOptionChecked" Margin="0,0,12,0" AutomationProperties.Name="Use Windows setting">
                        <StackPanel>
                          <Border Height="64" CornerRadius="4">
                            <Border.Background>
                              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F3F3F3" Offset="0.5" />
                                <GradientStop Color="#202020" Offset="0.5" />
                              </LinearGradientBrush>
                            </Border.Background>
                          </Border>
                          <TextBlock Text="Use Windows setting" Margin="4,8,0,2" />
                        </StackPanel>
                      </RadioButton>
                      <RadioButton x:Name="ThemeLightOption" GroupName="Theme" Tag="Light" Style="{StaticResource CardRadio}" Checked="ThemeOptionChecked" Margin="0,0,12,0" AutomationProperties.Name="Light">
                        <StackPanel>
                          <Border Height="64" CornerRadius="4" Background="#F3F3F3" BorderBrush="#E5E5E5" BorderThickness="1" />
                          <TextBlock Text="Light" Margin="4,8,0,2" />
                        </StackPanel>
                      </RadioButton>
                      <RadioButton x:Name="ThemeDarkOption" GroupName="Theme" Tag="Dark" Style="{StaticResource CardRadio}" Checked="ThemeOptionChecked" AutomationProperties.Name="Dark">
                        <StackPanel>
                          <Border Height="64" CornerRadius="4" Background="#202020" />
                          <TextBlock Text="Dark" Margin="4,8,0,2" />
                        </StackPanel>
                      </RadioButton>
                    </UniformGrid>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button x:Name="InstallUpdateButton" Content="Install from file…" Click="InstallUpdateClick" Margin="0,0,8,0" />
                      <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdatesClick" />
                    </StackPanel>
                    <StackPanel>
                      <TextBlock Text="App updates" Style="{StaticResource StrongText}" />
                      <TextBlock x:Name="VersionText" Text="FindIt only goes online when you ask it to. Updates are checked against the publisher's signed manifest." Style="{StaticResource SecondaryText}" Margin="0,0,12,0" />
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Style="{StaticResource PanelBorder}">
                  <StackPanel>
                    <TextBlock Text="Keyboard shortcuts" Style="{StaticResource StrongText}" Margin="0,0,0,8" />
                    <ItemsControl x:Name="ShortcutList" Focusable="False">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <DockPanel Margin="0,4">
                            <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,1">
                              <TextBlock Text="{Binding Keys}" FontSize="12" />
                            </Border>
                            <TextBlock Text="{Binding Action}" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                          </DockPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
