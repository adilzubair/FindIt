ationClick" IsEnabled="False"/></WrapPanel></StackPanel></Border><Border x:Name="ProgressCard" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="24" Margin="0,17,0,0" Visibility="Collapsed"><StackPanel><TextBlock x:Name="ProgressStage" Text="Preparing your archive" FontSize="18" FontWeight="SemiBold"/><ProgressBar x:Name="PreparationProgressBar" Height="5" Margin="0,19,0,14" Foreground="{DynamicResource AccentBrush}" Maximum="1"/><TextBlock x:Name="ProgressSummary"/><TextBlock x:Name="ProgressPath" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,9,0,0"/><TextBlock x:Name="ProgressMessage" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border><TextBlock Text="Available on this PC" FontWeight="SemiBold" FontSize="17" Margin="0,25,0,12"/><ItemsControl x:Name="CapabilitiesList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,11"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="IssuesHeading" Text="Files needing attention" FontWeight="SemiBold" FontSize="17" Margin="0,25,0,12"/><ItemsControl x:Name="IssuesList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceBrush}" Padding="12" Margin="0,0,0,7" CornerRadius="5"><StackPanel><TextBlock Text="{Binding RelativePath}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Message}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Search stays available during preparation. Keep this drive connected until the update is complete or paused." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,22,0,20" FontSize="12"/></StackPanel></ScrollViewer></Grid>
