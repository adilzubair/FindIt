<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
  <!-- Windows 11 conventions: 4 px control corners, 8 px card and overlay corners, a two-pixel ink focus ring. -->
  <Style x:Key="FocusRing" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" CornerRadius="6" Margin="-3"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Window"><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Background" Value="{DynamicResource CanvasBrush}"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/><Setter Property="UseLayoutRounding" Value="True"/></Style>
  <Style TargetType="Control"><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextOptions.TextFormattingMode" Value="Display"/></Style>

  <!-- Type ramp -->
  <Style x:Key="TitleText" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="HeadingText" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Style>
  <Style x:Key="SectionText" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Style>
  <Style x:Key="StrongText" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Style>
  <Style x:Key="SecondaryText" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="CaptionText" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/></Style>
  <Style x:Key="Glyph" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource IconFont}"/><Setter Property="FontSize" Value="16"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/></Style>

  <Style x:Key="PanelBorder" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="20"/></Style>
  <Style x:Key="SegmentGroup" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="2"/></Style>

  <!-- Buttons -->
  <Style TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,5"/><Setter Property="MinHeight" Value="32"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
        <Grid><Border x:Name="Hover" Background="{DynamicResource InkBrush}" Opacity="0" CornerRadius="3" IsHitTestVisible="False"/><ContentPresenter x:Name="Presenter" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/></Grid>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.04"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.08"/><Setter TargetName="Presenter" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource AccentButtonBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>
  <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/><Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="28"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,1"/><Setter Property="Padding" Value="10,5"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="FilterChip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="28"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="10,3"/><Setter Property="Background" Value="{DynamicResource TintBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,0,6,6"/></Style>
  <Style x:Key="SuggestionChip" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="14,5"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="16"><Grid><Border x:Name="Hover" Background="{DynamicResource InkBrush}" Opacity="0" CornerRadius="15"/><ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Grid></Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.04"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.08"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter></Style>
  <!-- A tile-like card button used for home shortcuts and settings rows. -->
  <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="16"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><Grid><Border x:Name="Hover" Background="{DynamicResource InkBrush}" Opacity="0" CornerRadius="7"/><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Grid></Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.03"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.06"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter></Style>

  <!-- A matching-moment tick on the playback timeline. -->
  <Style x:Key="TimelineMarker" TargetType="Button"><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"/></ControlTemplate></Setter.Value></Setter></Style>

  <!-- Navigation rail item: icon above a short label, with the Windows 11 selection pill. -->
  <Style x:Key="RailButton" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Width" Value="64"/><Setter Property="Height" Value="56"/><Setter Property="Margin" Value="0,2"/><Setter Property="Background" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6"><Grid><Border x:Name="Hover" Background="{DynamicResource InkBrush}" Opacity="0" CornerRadius="6"/><Border x:Name="Pill" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.04"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectedFillBrush}"/><Setter TargetName="Pill" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="RailActionButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="Width" Value="64"/><Setter Property="Height" Value="56"/><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="11"/></Style>

  <!-- Title bar caption buttons, drawn over the custom chrome. -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="46"/><Setter Property="Height" Value="32"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Focusable" Value="False"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}"><TextBlock x:Name="Icon" Text="{TemplateBinding Content}" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectedFillBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="Transparent"><TextBlock x:Name="Icon" Text="{TemplateBinding Content}" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#C42B1C"/><Setter TargetName="Icon" Property="Foreground" Value="White"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#C83C30"/><Setter TargetName="Icon" Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Segmented control item (file type tabs, gallery/list). -->
  <Style x:Key="TypeTab" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="12,0"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="MinHeight" Value="28"/><Setter Property="Background" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><Grid><Border x:Name="Hover" Background="{DynamicResource InkBrush}" Opacity="0" CornerRadius="4" Margin="-12,0"/><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True"/></Grid></Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.04"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource TintBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource QuietButton}"><Setter Property="MinHeight" Value="28"/><Setter Property="Width" Value="32"/><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="0"/></Style>
  <!-- Underlined page tabs (person page). -->
  <Style x:Key="PageTab" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="MinHeight" Value="40"/><Setter Property="Margin" Value="0,0,24,0"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><ContentPresenter VerticalAlignment="Center"/><Border x:Name="Underline" Height="3" CornerRadius="2" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/></Grid>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Underline" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- File tile: the outline sits on the thumbnail so captions stay quiet. -->
  <Style x:Key="ResultButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid Background="Transparent">
        <ContentPresenter x:Name="Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
        <Border x:Name="Hover" IsHitTestVisible="False" Height="{Binding ThumbnailHeight, FallbackValue=132}" VerticalAlignment="Top" Background="{DynamicResource InkBrush}" Opacity="0" CornerRadius="6"/>
        <Border x:Name="Outline" IsHitTestVisible="False" Height="{Binding ThumbnailHeight, FallbackValue=132}" VerticalAlignment="Top" BorderBrush="Transparent" BorderThickness="2" CornerRadius="7" Margin="-3"/>
        <Border x:Name="KeyboardRing" IsHitTestVisible="False" Height="{Binding ThumbnailHeight, FallbackValue=132}" VerticalAlignment="Top" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" CornerRadius="8" Margin="-4" Visibility="Collapsed"/>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.06"/></Trigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></DataTrigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="KeyboardRing" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Content" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PersonButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><Grid><Border x:Name="Hover" Background="{DynamicResource InkBrush}" Opacity="0" CornerRadius="8" Margin="0,-8"/><ContentPresenter/></Grid></Border>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.04"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.07"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>

  <!-- Text entry: a quiet field whose bottom edge becomes an accent underline on focus. -->
  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource InkBrush}"/><Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,5"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="32"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Grid><Border x:Name="Chrome" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True"><ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False" VerticalAlignment="Center"/></Border><Border x:Name="Underline" Height="1" Margin="4,0" VerticalAlignment="Bottom" Background="{DynamicResource StrongBorderBrush}" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Underline" Property="Height" Value="2"/><Setter TargetName="Underline" Property="Margin" Value="1,0"/><Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.42"/></Trigger><Trigger Property="Validation.HasError" Value="True"><Setter TargetName="Underline" Property="Background" Value="{DynamicResource ErrorBrush}"/></Trigger><Trigger Property="BorderThickness" Value="0"><Setter TargetName="Underline" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="MinHeight" Value="32"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="10,4"/><Setter Property="MinWidth" Value="100"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="Outline" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/><Border x:Name="Hover" Background="{DynamicResource InkBrush}" Opacity="0" CornerRadius="4" IsHitTestVisible="False"/><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton><TextBlock x:Name="SelectionPresenter" Text="{TemplateBinding Text}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="11,4,32,4" VerticalAlignment="Center" IsHitTestVisible="False" ClipToBounds="True"/><TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" IsHitTestVisible="False"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" PopupAnimation="None" Placement="Bottom" Focusable="False"><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Padding="4" Margin="8,4,8,12"><Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.18"/></Border.Effect><ScrollViewer MaxHeight="320" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="0.03"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="0,1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><Grid><Border x:Name="Pill" Width="3" Height="16" CornerRadius="2" Margin="-11,0,0,0" HorizontalAlignment="Left" Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/><ContentPresenter ClipToBounds="True"><ContentPresenter.Resources><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="TextWrapping" Value="NoWrap"/></Style></ContentPresenter.Resources></ContentPresenter></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectedFillBrush}"/><Setter TargetName="Pill" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="28"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Check" Width="20" Height="20" CornerRadius="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CheckBorderBrush}" BorderThickness="1" VerticalAlignment="Center"><TextBlock x:Name="Tick" Visibility="Collapsed" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource AccentButtonForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Background" Value="{DynamicResource AccentButtonBrush}"/><Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource AccentButtonBrush}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsChecked" Value="{x:Null}"><Setter TargetName="Check" Property="Background" Value="{DynamicResource TintBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Check" Property="BorderBrush" Value="{DynamicResource InkBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A CheckBox presented as a Windows 11 toggle switch. -->
  <Style x:Key="ToggleSwitch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Track" Width="40" Height="20" CornerRadius="10" Background="Transparent" BorderBrush="{DynamicResource CheckBorderBrush}" BorderThickness="1" VerticalAlignment="Center"><Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource MutedBrush}" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"/></Border><ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentButtonBrush}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentButtonBrush}"/><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentButtonForegroundBrush}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Width" Value="14"/><Setter TargetName="Knob" Property="Height" Value="14"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A pill-shaped toggle for the results filter bar. -->
  <Style x:Key="ChipSwitch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
    <Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="32"/>
