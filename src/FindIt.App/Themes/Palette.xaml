  <SolidColorBrush x:Key="PhotoTintBrush" Color="#DDF3EF"/>
  <SolidColorBrush x:Key="PhotoInkBrush" Color="#0B6A5B"/>
  <SolidColorBrush x:Key="VideoTintBrush" Color="#ECE6F7"/>
  <SolidColorBrush x:Key="VideoInkBrush" Color="#5B3F9E"/>
