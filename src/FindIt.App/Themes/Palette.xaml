<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Windows 11 ships Segoe UI Variable; Windows 10 falls back to Segoe UI. -->
  <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <!-- Light values. MainWindow.Appearance.cs replaces every key at runtime for light, dark and high contrast. -->
  <SolidColorBrush x:Key="CanvasBrush" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="LayerBrush" Color="#F9F9F9"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="InkBrush" Color="#1B1B1B"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#5C5C5C"/>
  <SolidColorBrush x:Key="SubtleBrush" Color="#6B6B6B"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#E5E5E5"/>
  <SolidColorBrush x:Key="StrongBorderBrush" Color="#C9C9C9"/>
  <SolidColorBrush x:Key="CheckBorderBrush" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#005FB8"/>
  <SolidColorBrush x:Key="AccentButtonBrush" Color="#005FB8"/>
  <SolidColorBrush x:Key="AccentButtonForegroundBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccentTextBrush" Color="#005FB8"/>
  <SolidColorBrush x:Key="FocusBrush" Color="#1B1B1B"/>
  <SolidColorBrush x:Key="TintBrush" Color="#E6EFF8"/>
  <SolidColorBrush x:Key="HoverBrush" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="SelectedFillBrush" Color="#EAEAEA"/>
  <SolidColorBrush x:Key="PreviewBrush" Color="#EDEDED"/>
  <SolidColorBrush x:Key="PaperBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="TrackBrush" Color="#D6D6D6"/>
  <SolidColorBrush x:Key="ScrimBrush" Color="#52000000"/>
  <SolidColorBrush x:Key="ReadyBrush" Color="#0F7B0F"/>
  <SolidColorBrush x:Key="ReadyTintBrush" Color="#DFF6DD"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#9D5D00"/>
  <SolidColorBrush x:Key="WarningTintBrush" Color="#FFF4CE"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C"/>
  <SolidColorBrush x:Key="ErrorTintBrush" Color="#FDE7E9"/>
  <SolidColorBrush x:Key="ShadowBrush" Color="#24000000"/>
  <!-- Layered icon tones: a readable silhouette, colored face, and detail. -->
  <SolidColorBrush x:Key="IconFolderBackBrush" Color="#BA801F"/>
  <SolidColorBrush x:Key="IconFolderFrontBrush" Color="#F0BE55"/>
  <SolidColorBrush x:Key="IconFolderDetailBrush" Color="#FFF0C7"/>
  <SolidColorBrush x:Key="IconLibraryBackBrush" Color="#2868BA"/>
  <SolidColorBrush x:Key="IconLibraryFrontBrush" Color="#69A4ED"/>
  <SolidColorBrush x:Key="IconLibraryDetailBrush" Color="#EAF4FF"/>
  <SolidColorBrush x:Key="IconPeopleBackBrush" Color="#7358AF"/>
  <SolidColorBrush x:Key="IconPeopleFrontBrush" Color="#AB8DDD"/>
  <SolidColorBrush x:Key="IconPeopleDetailBrush" Color="#F4EDFF"/>
  <SolidColorBrush x:Key="IconPhotoBackBrush" Color="#207B80"/>
  <SolidColorBrush x:Key="IconPhotoFrontBrush" Color="#5AB4AB"/>
  <SolidColorBrush x:Key="IconPhotoDetailBrush" Color="#E4FAF2"/>
  <SolidColorBrush x:Key="IconVideoBackBrush" Color="#7756AC"/>
  <SolidColorBrush x:Key="IconVideoFrontBrush" Color="#AA83D8"/>
  <SolidColorBrush x:Key="IconVideoDetailBrush" Color="#F6EDFF"/>
  <SolidColorBrush x:Key="IconDocumentBackBrush" Color="#2868BA"/>
